index 0000000..7921d51
--- /dev/null
+++ b/fulcra_mcp/unblock_resource.py
@@ -0,0 +1,81 @@
+"""Resource checks for the isolated Unblock token branch.
+
+The provider behind this handler must return durable resource-bound codes and
+refresh records. Its load methods are read-only. Existing Fulcra OAuth clients
+keep their original handler; mounting this branch waits for that provider.
+"""
+
+from typing import Any
+
+from mcp.server.auth.handlers.token import TokenHandler
+from mcp.server.auth.provider import TokenError
+from starlette.requests import Request
+
+
+def parse_resource(form_items: list[tuple[str, str]]) -> str | None:
+    values = [value for key, value in form_items if key == "resource"]
+    if len(values) > 1:
+        raise TokenError("invalid_request", "resource must occur at most once")
+    if not values:
+        return None
+    value = values[0]
+    if not isinstance(value, str) or not value or value.strip() != value:
+        raise TokenError(
+            "invalid_request", "resource must be a nonempty exact identifier"
+        )
+    return value
+
+
+def require_resource(requested: str | None, bound: str, *, refresh: bool) -> str:
+    if not isinstance(bound, str) or not bound or bound.strip() != bound:
+        raise TokenError("invalid_grant", "resource binding unavailable")
+    if requested is None and refresh:
+        return bound
+    if requested != bound:
+        raise TokenError("invalid_grant", "resource does not match the grant")
+    return bound
+
+
+class _BoundExchanges:
+    """Per-request wrapper; no mutable request state on the shared provider."""
+
+    def __init__(self, provider: Any, request: Request):
+        self._provider = provider
+        self._request = request
+
+    def __getattr__(self, name: str):
+        return getattr(self._provider, name)
+
+    async def _check(self, record: Any, *, refresh: bool):
+        # The SDK has already authenticated and parsed this same Request. Its
+        # cached FormData retains duplicates discarded by dict(form_data).
+        form = await self._request.form()
+        requested = parse_resource(list(form.multi_items()))
+        require_resource(requested, getattr(record, "resource", None), refresh=refresh)
+
+    async def load_authorization_code(self, client, raw_code):
+        code = await self._provider.load_authorization_code(client, raw_code)
+        observer = getattr(self._provider, "observe_code_replay", None)
+        if code is not None and observer is not None:
+            # The SDK has authenticated the client. The observer independently
+            # checks redirect, PKCE and resource before revocation-only cleanup,
+            # including when the SDK would stop at an expired consumed code.
+            form = await self._request.form()
+            await observer(client, code, list(form.multi_items()))
+        return code
+
+    async def exchange_authorization_code(self, client, code):
+        await self._check(code, refresh=False)
+        return await self._provider.exchange_authorization_code(client, code)
+
+    async def exchange_refresh_token(self, client, token, scopes):
+        await self._check(token, refresh=True)
+        return await self._provider.exchange_refresh_token(client, token, scopes)
+
+
+class ResourceTokenHandler(TokenHandler):
+    async def handle(self, request: Request):
+        # Retain the SDK's client, redirect, PKCE, expiry and scope checks.
+        # A new wrapper for every request prevents concurrent caller leakage.
+        guarded = _BoundExchanges(self.provider, request)
+        return await TokenHandler(guarded, self.client_authenticator).handle(request)
diff --git a/fulcra_mcp/unblock_state.py b/fulcra_mcp/unblock_state.py
new file mode 100644
index 0000000..579811a
--- /dev/null
+++ b/fulcra_mcp/unblock_state.py
@@ -0,0 +1,260 @@
+"""Separate resource state using GCS generation preconditions, never a mount.
+
+No credentials are discovered at import. Call configured_store only when the
+new resource branch is explicitly enabled with an existing authorized bucket.
+"""
+
+import hashlib
+import json
+import re
+import time
+from typing import Any
+
+from google.api_core.exceptions import NotFound, PreconditionFailed
+from google.cloud import storage
+from google.cloud.storage.retry import DEFAULT_RETRY_IF_GENERATION_SPECIFIED
+
+from .settings import settings
+
+MAX_RECORD_BYTES = 65536
+TIMEOUT_SECONDS = 15
+
+
+class StateConflict(Exception):
+    """The observed generation or transition no longer holds."""
+
+
+class StateUnavailable(Exception):
+    """Storage/effect state is unknown; this never means an empty queue."""
+
+
+class StateInvalid(ValueError):
+    """Invalid local key/value; no storage operation was performed."""
+
+
+def state_key(kind: str, secret: str) -> str:
+    if not isinstance(kind, str) or not re.fullmatch(r"[a-z][a-z0-9_-]{0,39}", kind):
+        raise StateInvalid("invalid state kind")
+    if not isinstance(secret, str) or not secret:
+        raise StateInvalid("missing state identifier")
+    return kind + "/" + hashlib.sha256(secret.encode()).hexdigest()
+
+
+def _snapshot(value: dict) -> tuple[dict, bytes]:
+    if not isinstance(value, dict):
+        raise StateInvalid("state must be an object")
+    try:
+        raw = json.dumps(
+            value, sort_keys=True, separators=(",", ":"), allow_nan=False
+        ).encode()
+    except (ValueError, TypeError, OverflowError):
+        raise StateInvalid("invalid state data") from None
+    if len(raw) > MAX_RECORD_BYTES:
+        raise StateInvalid("state record too large")
+    return json.loads(raw), raw
+
+
+def _generation(value: Any) -> int:
+    if type(value) is int and value > 0:
+        return value
+    if isinstance(value, str) and re.fullmatch(r"[0-9]+", value) and int(value) > 0:
+        return int(value)
+    raise StateUnavailable("state generation unavailable")
+
+
+class StateStore:
+    def __init__(self, bucket):
+        if bucket is None:
+            raise StateUnavailable("resource state storage is not configured")
+        self._bucket = bucket
+
+    def _blob(self, key: str):
+        if not isinstance(key, str) or not re.fullmatch(
+            r"[a-z][a-z0-9_-]{0,39}/[a-f0-9]{64}", key
+        ):
+            raise StateInvalid("invalid state key")
+        return self._bucket.blob("unblock/v1/" + key)
+
+    def read(self, key: str) -> tuple[dict, int] | None:
+        blob = self._blob(key)
+        try:
+            blob.reload(timeout=TIMEOUT_SECONDS)
+        except NotFound:
+            try:
+                if self._bucket.exists(timeout=TIMEOUT_SECONDS):
+                    return None
+            except Exception:
+                pass
+            raise StateUnavailable("resource state bucket unavailable") from None
+        except Exception:
+            raise StateUnavailable("resource state read unavailable") from None
+        generation = _generation(blob.generation)
+        try:
+            raw = blob.download_as_bytes(
+                if_generation_match=generation,
+                timeout=TIMEOUT_SECONDS,
+                retry=DEFAULT_RETRY_IF_GENERATION_SPECIFIED,
+            )
+            if len(raw) > MAX_RECORD_BYTES:
+                raise ValueError("oversized")
+            value = json.loads(raw)
+            if not isinstance(value, dict):
+                raise ValueError("not an object")
+            # Reject malformed/nonfinite source rather than normalizing it away.
+            _snapshot(value)
+        except (PreconditionFailed, NotFound):
+            raise StateConflict("resource state changed during read") from None
+        except Exception:
+            raise StateUnavailable("resource state content unavailable") from None
+        return value, generation
+
+    def _write(self, key: str, value: dict, generation: int) -> int:
+        blob = self._blob(key)
+        _, raw = _snapshot(value)
+        try:
+            blob.upload_from_string(
+                raw,
+                content_type="application/json",
+                if_generation_match=generation,
+                timeout=TIMEOUT_SECONDS,
+                retry=DEFAULT_RETRY_IF_GENERATION_SPECIFIED,
+            )
+        except PreconditionFailed:
+            raise StateConflict("resource state generation changed") from None
+        except Exception:
+            # A timeout can follow a successful write. Preserve/reconcile the
+            # original transition; never report a definite no-effect failure.
+            raise StateUnavailable("resource state write outcome unavailable") from None
+        return _generation(blob.generation)
+
+    def create(self, key: str, value: dict) -> int:
+        return self._write(key, value, 0)
+
+    def replace(self, key: str, value: dict, generation: int) -> int:
+        if type(generation) is not int or generation <= 0:
+            raise StateInvalid("expected positive state generation")
+        return self._write(key, value, generation)
+
+
+def configured_store() -> StateStore:
+    bucket_name = settings.state_bucket
+    if (
+        not isinstance(bucket_name, str)
+        or not bucket_name
+        or bucket_name.strip() != bucket_name
+    ):
+        raise StateUnavailable("resource state bucket is not configured")
+    try:
+        return StateStore(storage.Client().bucket(bucket_name))
+    except Exception:
+        raise StateUnavailable("resource state client unavailable") from None
+
+
+class Transactions:
+    """One-time claims and explicit reconciliation; no expired-lease takeover."""
+
+    def __init__(self, store: StateStore, *, now=time.time):
+        self.store, self.now = store, now
+
+    def begin(self, key: str, binding: dict, expires_at: int) -> int:
+        if type(expires_at) is not int or expires_at <= self.now():
+            raise StateInvalid("transaction requires a future expiry")
+        binding, _ = _snapshot(binding)
+        return self.store.create(
+            key,
+            {
+                "status": "pending",
+                "binding": binding,
+                "expires_at": expires_at,
+                "claim_id": None,
+                "result": None,
+                "checkpoints": {},
+                "history": [{"status": "pending", "at": int(self.now())}],
+            },
+        )
+
+    def _read(self, key: str) -> tuple[dict, int]:
+        observed = self.store.read(key)
+        if observed is None:
+            raise StateConflict("transaction not found")
+        row, generation = observed
+        if (
+            row.get("status") not in ("pending", "claimed", "completed", "uncertain")
+            or not isinstance(row.get("binding"), dict)
+            or type(row.get("expires_at")) is not int
+            or not isinstance(row.get("history"), list)
+        ):
+            raise StateUnavailable("transaction state malformed")
+        return row, generation
+
+    def claim(self, key: str, claim_id: str) -> tuple[dict, int]:
+        if not isinstance(claim_id, str) or not claim_id or len(claim_id) > 160:
+            raise StateInvalid("claim identifier required")
+        row, generation = self._read(key)
+        if row["status"] != "pending" or row["expires_at"] <= self.now():
+            raise StateConflict("transaction is not pending or has expired")
+        updated = {
+            **row,
+            "status": "claimed",
+            "claim_id": claim_id,
+            "history": row["history"] + [{"status": "claimed", "at": int(self.now())}],
+        }
+        return updated, self.store.replace(key, updated, generation)
+
+    def checkpoint(
+        self, key: str, claim_id: str, name: str, value: dict
+    ) -> tuple[dict, int]:
+        if not isinstance(name, str) or not re.fullmatch(r"[a-z][a-z0-9_]{0,63}", name):
+            raise StateInvalid("invalid effect checkpoint name")
+        value, raw = _snapshot(value)
+        row, generation = self._read(key)
+        if row.get("claim_id") != claim_id or row["status"] not in (
+            "claimed",
+            "uncertain",
+        ):
+            raise StateConflict("transaction claim changed")
+        checkpoints = row.get("checkpoints", {})
+        if not isinstance(checkpoints, dict):
+            raise StateUnavailable("effect checkpoints malformed")
+        if name in checkpoints:
+            if checkpoints[name] != value:
+                raise StateConflict("frozen effect checkpoint changed")
+            return row, generation
+        updated = {
+            **row,
+            "checkpoints": {**checkpoints, name: value},
+            "history": row["history"]
+            + [
+                {
+                    "status": row["status"],
+                    "checkpoint": name,
+                    "sha256": hashlib.sha256(raw).hexdigest(),
+                    "at": int(self.now()),
+                }
+            ],
+        }
+        return updated, self.store.replace(key, updated, generation)
+
+    def finish(
+        self, key: str, claim_id: str, status: str, result: dict
+    ) -> tuple[dict, int]:
+        if status not in ("completed", "uncertain"):
+            raise StateInvalid("invalid transaction outcome")
+        result, _ = _snapshot(result)
+        row, generation = self._read(key)
+        if row.get("claim_id") != claim_id:
+            raise StateConflict("transaction claim changed")
+        if row["status"] == status and row["result"] == result:
+            return row, generation
+        if row["status"] != "claimed" and not (
+            row["status"] == "uncertain" and status == "completed"
+        ):
+            raise StateConflict("transaction outcome already retained")
+        updated = {
+            **row,
+            "status": status,
+            "result": result,
+            "history": row["history"]
+            + [{"status": status, "at": int(self.now()), "result": result}],
+        }
+        return updated, self.store.replace(key, updated, generation)
diff --git a/tests/test_unblock_bridge.py b/tests/test_unblock_bridge.py
new file mode 100644
index 0000000..0591952
--- /dev/null
+++ b/tests/test_unblock_bridge.py
@@ -0,0 +1,259 @@
+"""HTTP boundary tests; the native grant service has separate live evidence."""
+
+import json
+import httpx
+import pytest
+
+from fulcra_mcp.unblock_bridge import (
+    NativeBridge,
+    OwnerAccess,
+    BridgeRejected,
+    BridgeUnavailable,
+)
+
+PROJECT = "11111111-1111-4111-8111-111111111111"
+GRANT = "22222222-2222-4222-8222-222222222222"
+RECORD = "33333333-3333-4333-8333-333333333333"
+ORIGIN = "https://dashboard.my.fulcra.ai"
+RESOURCE = ORIGIN + "/mcp"
+
+
+class Service:
+    def __init__(self):
+        self.calls = []
+        self.grants = []
+        self.post_bodies = []
+        self.fail_after_effect = False
+        self.fail_revoke_after_effect = False
+        self.foreign = False
+        self.domain = "dashboard.my.fulcra.ai"
+        self.redirect = False
+
+    def __call__(self, request):
+        self.calls.append(request)
+        path = request.url.path
+        if request.url.host == "api.invalid":
+            if path == "/user/v1alpha1/info":
+                return httpx.Response(200, json={"userid": "human-a"})
+            if path == "/user/v1/deploy/project/" + PROJECT:
+                if self.foreign:
+                    return httpx.Response(404)
+                if self.redirect:
+                    return httpx.Response(
+                        302, headers={"Location": "https://evil.invalid/steal"}
+                    )
+                return httpx.Response(200, json={"id": PROJECT, "domain": self.domain})
+            return httpx.Response(404)
+        assert request.url.host == "dashboard.my.fulcra.ai"
+        if path.endswith("/prepare_enrollment"):
+            return httpx.Response(200, json={"expires_at": 200})
+        if path.endswith("/attention"):
+            return httpx.Response(
+                200, json={"source": "checked", "grants": self.grants, "requests": []}
+            )
+        if path.endswith("/enroll"):
+            body = json.loads(request.content)
+            self.post_bodies.append(body)
+            if not self.grants:
+                self.grants.append(
+                    {
+                        **body,
+                        "grant_id": GRANT,
+                        "record_id": RECORD,
+                        "agent_ids": ["worker"],
+                        "revoked": False,
+                    }
+                )
+            if self.fail_after_effect:
+                self.fail_after_effect = False
+                raise httpx.ReadTimeout("synthetic lost response", request=request)
+            return httpx.Response(
+                200,
+                json={
+                    **body,
+                    "grant_id": GRANT,
+                    "record_id": RECORD,
+                    "credential": "synthetic-worker-grant",
+                    "visibility": "visible",
+                    "agent_ids": ["worker"],
+                },
+            )
+        if path.endswith("/revoke"):
+            body = json.loads(request.content)
+            for grant in self.grants:
+                if grant["grant_id"] == body["grant_id"]:
+                    grant["revoked"] = True
+            if self.fail_revoke_after_effect:
+                self.fail_revoke_after_effect = False
+                raise httpx.ReadTimeout(
+                    "synthetic lost revocation response", request=request
+                )
+            return httpx.Response(
+                200, json={"visibility": "visible", "record_id": RECORD}
+            )
+        if path.endswith("/enrollment"):
+            return httpx.Response(
+                200,
+                json={
+                    "kind": "agent",
+                    "id": "worker",
+                    "environment": "env",
+                    "grant_id": GRANT,
+                    "expires_at": 200,
+                    "agent_ids": ["worker"],
+                },
+            )
+        return httpx.Response(404)
+
+
+@pytest.fixture
+def context():
+    service = Service()
+    bridge = NativeBridge(
+        "https://api.invalid", transport=httpx.MockTransport(service), now=lambda: 100
+    )
+    owner = OwnerAccess("synthetic-owner-access", 500)
+    return service, bridge, owner
+
+
+async def binding(bridge, owner, resource=RESOURCE):
+    return await bridge.resolve_owned_project(
+        owner, PROJECT, resource, "worker", "env", "Worker"
+    )
+
+
+@pytest.mark.parametrize(
+    "foreign,domain,resource",
+    [
+        (True, "dashboard.my.fulcra.ai", RESOURCE),
+        (False, "other.my.fulcra.ai", RESOURCE),
+        (False, "evil.invalid", "https://evil.invalid/mcp"),
+        (False, "dashboard.my.fulcra.ai", ORIGIN + ":443/mcp"),
+        (False, "dashboard.my.fulcra.ai", "https://user@dashboard.my.fulcra.ai/mcp"),
+    ],
+)
+async def test_ownership_and_canonical_domain_precede_dashboard_credentials(
+    context, foreign, domain, resource
+):
+    service, bridge, owner = context
+    service.foreign, service.domain = foreign, domain
+    with pytest.raises(BridgeRejected):
+        await binding(bridge, owner, resource)
+    assert all(request.url.host == "api.invalid" for request in service.calls)
+
+
+async def test_platform_redirect_is_not_followed(context):
+    service, bridge, owner = context
+    service.redirect = True
+    with pytest.raises(BridgeRejected):
+        await binding(bridge, owner)
+    assert all(request.url.host == "api.invalid" for request in service.calls)
+
+
+async def test_native_grant_is_frozen_verified_and_narrow(context):
+    service, bridge, owner = context
+    approved = await binding(bridge, owner)
+    intent = await bridge.prepare_enrollment(approved, owner, "intent-1")
+    receipt = await bridge.enroll_worker(approved, owner, intent)
+    assert receipt.grant_id == GRANT and receipt.expires_at == 200
+    assert "synthetic-worker-grant" not in repr(receipt)
+    assert service.post_bodies == [
+        {
+            "intent_id": "intent-1",
+            "agent_id": "worker",
+            "name": "Worker",
+            "kind": "agent",
+            "environment": "env",
+            "expires_at": 200,
+            "renewal_of": None,
+        }
+    ]
+    native_owner = [
+        r
+        for r in service.calls
+        if r.url.host == "dashboard.my.fulcra.ai"
+        and not r.url.path.endswith("/enrollment")
+    ]
+    assert all(r.headers.get("origin") == ORIGIN for r in native_owner)
+    assert all(
+        r.headers.get("cookie") == "fulcra_access_token=synthetic-owner-access"
+        for r in native_owner
+    )
+    assert "synthetic-owner-access" not in repr(owner)
+
+
+async def test_lost_response_reconciles_exact_source_before_credential_recovery(
+    context,
+):
+    service, bridge, owner = context
+    approved = await binding(bridge, owner)
+    intent = await bridge.prepare_enrollment(approved, owner, "intent-1")
+    service.fail_after_effect = True
+    with pytest.raises(BridgeUnavailable):
+        await bridge.enroll_worker(approved, owner, intent)
+    replacement = NativeBridge(
+        "https://api.invalid", transport=httpx.MockTransport(service), now=lambda: 100
+    )
+    receipt = await replacement.reconcile_enrollment(approved, owner, intent)
+    assert receipt.grant_id == GRANT
+    assert service.post_bodies == [intent, intent]
+    assert len(service.grants) == 1
+    paths = [r.url.path for r in service.calls]
+    assert paths.index("/api/unblock/attention") < len(paths) - 2
+
+
+async def test_missing_unknown_or_changed_receipt_never_reposts(context):
+    service, bridge, owner = context
+    approved = await binding(bridge, owner)
+    intent = await bridge.prepare_enrollment(approved, owner, "intent-1")
+    assert await bridge.reconcile_enrollment(approved, owner, intent) is None
+    assert service.post_bodies == []
+    service.grants = [
+        {
+            **intent,
+            "grant_id": GRANT,
+            "record_id": RECORD,
+            "agent_ids": ["worker"],
+            "revoked": False,
+            "environment": "another",
+        }
+    ]
+    with pytest.raises(BridgeRejected):
+        await bridge.reconcile_enrollment(approved, owner, intent)
+    assert service.post_bodies == []
+
+
+async def test_removed_project_blocks_renewal_before_owner_forwarding(context):
+    service, bridge, owner = context
+    approved = await binding(bridge, owner)
+    service.calls.clear()
+    service.foreign = True
+    with pytest.raises(BridgeRejected):
+        await bridge.prepare_enrollment(approved, owner, "renewal-1", renewal_of=GRANT)
+    assert all(request.url.host == "api.invalid" for request in service.calls)
+
+
+async def test_revocation_needs_exact_owned_scope_and_actual_readback(context):
+    service, bridge, owner = context
+    approved = await binding(bridge, owner)
+    intent = await bridge.prepare_enrollment(approved, owner, "intent-1")
+    await bridge.enroll_worker(approved, owner, intent)
+    service.grants[0]["environment"] = "another"
+    with pytest.raises(BridgeRejected):
+        await bridge.revoke_worker(approved, owner, GRANT, "revoke-1")
+    assert not any(r.url.path.endswith("/revoke") for r in service.calls)
+    service.grants[0]["environment"] = "env"
+    assert await bridge.revoke_worker(approved, owner, GRANT, "revoke-1") is True
+    assert await bridge.revocation_observed(approved, owner, GRANT) is True
+
+
+async def test_lost_revocation_response_reconciles_without_another_post(context):
+    service, bridge, owner = context
+    approved = await binding(bridge, owner)
+    intent = await bridge.prepare_enrollment(approved, owner, "intent-1")
+    await bridge.enroll_worker(approved, owner, intent)
+    service.fail_revoke_after_effect = True
+    with pytest.raises(BridgeUnavailable):
+        await bridge.revoke_worker(approved, owner, GRANT, "revoke-1")
+    assert await bridge.revocation_observed(approved, owner, GRANT) is True
+    assert len([r for r in service.calls if r.url.path.endswith("/revoke")]) == 1
