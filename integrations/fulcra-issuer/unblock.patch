+    async def load_authorization_code(self, client, authorization_code):
+        if not isinstance(authorization_code, str) or not re.fullmatch(
+            r"uaa-code-[a-f0-9]{64}", authorization_code
+        ):
+            return None
+        observed = await self._read(state_key("code", authorization_code))
+        if observed is None or observed[0]["binding"]["client_id"] != client.client_id:
+            return None
+        row = observed[0]
+        binding = row["binding"]
+        return AuthorizationCode(
+            code=authorization_code,
+            client_id=binding["client_id"],
+            scopes=binding["scopes"],
+            expires_at=row["expires_at"],
+            code_challenge=binding["challenge"],
+            redirect_uri=binding["redirect_uri"],
+            redirect_uri_provided_explicitly=binding["redirect_explicit"],
+            resource=binding["resource"],
+            subject=binding["project"]["subject"],
+        )
