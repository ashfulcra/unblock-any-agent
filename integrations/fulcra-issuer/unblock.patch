+                state_key("login", state), binding, int(self.now()) + LOGIN_SECONDS
+            )
+            api = self.upstream_factory()
+            return await asyncio.to_thread(
+                api.get_authorization_code_url,
+                redirect_uri=self.origin + "/callback",
+                state=state,
+            )
+        except Exception:
+            raise AuthorizeError(
+                "invalid_request", "worker authorization could not start"
+            ) from None
+
+    @staticmethod
+    def owns_state(state):
+        return (
+            isinstance(state, str)
+            and re.fullmatch(r"uaa-login-[a-f0-9]{64}", state) is not None
+        )
+
+    async def receive_callback(self, upstream_code, state):
