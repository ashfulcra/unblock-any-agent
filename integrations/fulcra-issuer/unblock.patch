+from datetime import datetime
+from urllib.parse import parse_qs, urlencode, urlsplit
+from uuid import UUID, uuid5
+
+import pytest
+from fulcra_api.credentials import FulcraCredentials
+from mcp.server.auth.provider import AuthorizationParams
+from mcp.shared.auth import OAuthClientInformationFull
+from starlette.requests import Request
+from test_unblock_state import Backend
+
+from fulcra_mcp.unblock_bridge import (
+    ProjectBinding,
+    NativeGrantReceipt,
+    BridgeRejected,
+    BridgeUnavailable,
+)
+from fulcra_mcp.unblock_owner import OwnerVault
+from fulcra_mcp.unblock_provider import UnblockProvider
+from fulcra_mcp.unblock_resource import ResourceTokenHandler
+from fulcra_mcp.unblock_state import StateStore
+
+CLIENT = OAuthClientInformationFull(
+    client_id="same-client",
+    client_name="<Untrusted client>",
+    redirect_uris=["https://client.invalid/callback"],
+    grant_types=["authorization_code", "refresh_token"],
+)
+VERIFIER = "v" * 43
+CHALLENGE = (
+    base64.urlsafe_b64encode(hashlib.sha256(VERIFIER.encode()).digest())
+    .decode()
+    .rstrip("=")
+)
+RESOURCE_A = "https://a.my.fulcra.ai/mcp"
+RESOURCE_B = "https://b.my.fulcra.ai/mcp"
+
+
+class Upstream:
+    def __init__(self, clock):
+        self.clock, self.fulcra_credentials = clock, None
+
+    def get_authorization_code_url(self, *, redirect_uri, state):
+        assert redirect_uri == "https://issuer.invalid/callback"
+        return "https://auth.invalid/authorize?" + urlencode({"state": state})
+
+    def authorize_with_authorization_code(self, *, code, redirect_uri):
+        assert redirect_uri == "https://issuer.invalid/callback"
+        self.fulcra_credentials = FulcraCredentials(
+            access_token="synthetic-access-" + code,
+            access_token_expiration=datetime.fromtimestamp(self.clock[0] + 500),
+            refresh_token="synthetic-owner-refresh-" + code,
+        )
+
+
+class Bridge:
+    def __init__(self, clock):
+        self.clock, self.grants, self.revoked = clock, {}, set()
+        self.lose_enrollment = False
+        self.lose_revocation = False
+        self.lose_revocation_readback = False
+
+    async def find_project(self, owner, resource):
+        await asyncio.sleep(0)
+        identity = "a" if owner.token.startswith("synthetic-access-a") else "b"
+        if resource != f"https://{identity}.my.fulcra.ai/mcp":
+            raise BridgeRejected("foreign dashboard")
+        return ProjectBinding(
+            "human-" + identity,
+            str(uuid5(UUID(int=0), identity)),
+            resource[:-4],
+            resource,
+            "pending-consent",
+            "pending-consent",
+            "Pending consent",
+        )
+
+    async def resolve_owned_project(
+        self, owner, project_id, resource, agent, environment, name
+    ):
+        project = await self.find_project(owner, resource)
+        if project.project_id != project_id:
+            raise BridgeRejected("foreign project")
+        return replace(project, agent=agent, environment=environment, name=name)
+
+    async def prepare_enrollment(self, binding, owner, intent_id, *, renewal_of=None):
+        return {
+            "intent_id": intent_id,
+            "agent_id": binding.agent,
+            "name": binding.name,
+            "kind": "agent",
+            "environment": binding.environment,
+            "expires_at": self.clock[0] + 100,
+            "renewal_of": renewal_of,
+        }
+
+    async def enroll_worker(self, binding, owner, intent):
+        grant_id = str(uuid5(UUID(int=0), intent["intent_id"]))
+        receipt = NativeGrantReceipt(
+            grant_id,
+            str(uuid5(UUID(int=1), grant_id)),
+            "synthetic-native-" + grant_id,
+            intent["expires_at"],
+        )
+        self.grants.setdefault(intent["intent_id"], (binding, intent, receipt))
+        if self.lose_enrollment:
+            self.lose_enrollment = False
+            raise BridgeUnavailable("lost enrollment response")
+        return receipt
+
+    async def reconcile_enrollment(self, binding, owner, intent):
+        row = self.grants.get(intent["intent_id"])
+        if row and row[2].grant_id in self.revoked:
+            raise BridgeRejected("retained enrollment revoked")
+        return row[2] if row else None
+
+    async def revoke_worker(self, binding, owner, grant_id, intent_id):
+        self.revoked.add(grant_id)
+        if self.lose_revocation:
+            self.lose_revocation = False
+            raise BridgeUnavailable("lost revocation response")
+        return True
+
+    async def revocation_observed(self, binding, owner, grant_id):
+        if self.lose_revocation_readback:
+            self.lose_revocation_readback = False
+            raise BridgeUnavailable("revocation readback temporarily unavailable")
+        return grant_id in self.revoked
+
