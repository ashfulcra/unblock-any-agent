@@ -0,0 +1,147 @@
+"""Owner refresh is a one-time durable effect, isolated from OAuth clients."""
+
+import asyncio
+from datetime import datetime
+
+import pytest
+from fulcra_api.credentials import FulcraCredentials
+from test_unblock_state import Backend
+from fulcra_mcp.unblock_state import StateStore
+from fulcra_mcp.unblock_owner import OwnerVault
+from fulcra_mcp.unblock_bridge import BridgeRejected, BridgeUnavailable
+
+
+def credentials(tag, expiry):
+    return FulcraCredentials(
+        access_token="synthetic-access-" + tag,
+        access_token_expiration=datetime.fromtimestamp(expiry),
+        refresh_token="synthetic-refresh-" + tag,
+    )
+
+
+async def test_credentials_survive_replacement_without_a_client_slot():
+    store = StateStore(Backend())
+    vault = OwnerVault(store, now=lambda: 100)
+    a = await vault.save(credentials("a", 500), "human-a", 1000)
+    b = await vault.save(credentials("b", 500), "human-b", 1000)
+    replacement = OwnerVault(store, now=lambda: 100)
+    assert (await replacement.load(a)).token == "synthetic-access-a"
+    assert (await replacement.load(b)).token == "synthetic-access-b"
+    assert a != b
+
+
+async def test_one_instance_refreshes_while_another_keeps_uncertainty_visible():
+    backend = Backend()
+    store = StateStore(backend)
+    started, release = asyncio.Event(), asyncio.Event()
+    effects = []
+
+    async def refresh(old):
+        effects.append(old.refresh_token)
+        started.set()
+        await release.wait()
+        return credentials("new", 900)
+
+    a = OwnerVault(store, refresh=refresh, now=lambda: 450)
+    key = await a.save(credentials("old", 500), "human-a", 1000)
+    b = OwnerVault(StateStore(backend), refresh=refresh, now=lambda: 450)
+    first = asyncio.create_task(a.load(key))
+    await started.wait()
+    with pytest.raises(BridgeUnavailable):
+        await b.load(key)
+    release.set()
+    assert (await first).token == "synthetic-access-new"
+    assert (await b.load(key)).token == "synthetic-access-new"
+    assert effects == ["synthetic-refresh-old"]
+
+
+async def test_unknown_refresh_is_not_repeated_after_restart():
+    store = StateStore(Backend())
+    effects = []
+
+    async def refresh(old):
+        effects.append("attempted")
+        raise OSError("synthetic-sensitive-value")
+
+    a = OwnerVault(store, refresh=refresh, now=lambda: 450)
+    key = await a.save(credentials("old", 500), "human-a", 1000)
+    with pytest.raises(BridgeUnavailable) as caught:
+        await a.load(key)
+    assert "synthetic-sensitive-value" not in str(caught.value)
+    with pytest.raises(BridgeUnavailable):
+        await OwnerVault(store, refresh=refresh, now=lambda: 450).load(key)
+    assert effects == ["attempted"]
+    assert store.read(key)[0]["refresh_state"] == "uncertain"
+
+
+async def test_lost_persistence_after_refresh_never_repeats_the_upstream_effect():
+    backend = Backend()
+    store = StateStore(backend)
+    effects = []
+
+    async def refresh(old):
+        effects.append("attempted")
+        backend.unavailable = True
+        return credentials("new", 900)
+
+    vault = OwnerVault(store, refresh=refresh, now=lambda: 450)
+    key = await vault.save(credentials("old", 500), "human-a", 1000)
+    with pytest.raises(BridgeUnavailable):
+        await vault.load(key)
+    backend.unavailable = False
+    with pytest.raises(BridgeUnavailable):
+        await OwnerVault(store, refresh=refresh, now=lambda: 450).load(key)
+    assert effects == ["attempted"]
+    assert store.read(key)[0]["refresh_state"] in ["claimed", "uncertain"]
+
+
+async def test_expiry_and_revocation_prevent_new_access_and_preserve_cleanup():
+    store = StateStore(Backend())
+    clock = [100]
+    vault = OwnerVault(store, now=lambda: clock[0])
+    key = await vault.save(credentials("a", 500), "human-a", 600)
+    await vault.request_revocation(key)
+    with pytest.raises(BridgeRejected):
+        await vault.load(key)
+    assert (await vault.load(key, for_revocation=True)).token == "synthetic-access-a"
+    await vault.disable(key)
+    with pytest.raises(BridgeRejected):
+        await vault.load(key, for_revocation=True)
+    assert store.read(key)[0]["credentials"] is None
+    key2 = await vault.save(credentials("b", 500), "human-b", 600)
+    clock[0] = 601
+    with pytest.raises(BridgeRejected):
+        await vault.load(key2)
+
+
+async def test_revocation_during_refresh_does_not_erase_known_new_credentials_or_reenable_access():
+    store = StateStore(Backend())
+    started, release = asyncio.Event(), asyncio.Event()
+
+    async def refresh(old):
+        started.set()
+        await release.wait()
+        return credentials("new", 900)
+
+    vault = OwnerVault(store, refresh=refresh, now=lambda: 450)
+    key = await vault.save(credentials("old", 500), "human-a", 1000)
+    task = asyncio.create_task(vault.load(key))
+    await started.wait()
+    await vault.request_revocation(key)
+    release.set()
+    with pytest.raises(BridgeRejected):
+        await task
+    assert (await vault.load(key, for_revocation=True)).token == "synthetic-access-new"
+    assert store.read(key)[0]["revocation_requested"] is True
+
+
+async def test_frozen_owner_reference_reconciles_a_lost_create_response():
+    from fulcra_mcp.unblock_state import state_key
+
+    backend = Backend()
+    backend.hide_upload_generation = True
+    store = StateStore(backend)
+    vault = OwnerVault(store, now=lambda: 100)
+    key = state_key("owner", "frozen-login-transaction")
+    assert await vault.save(credentials("a", 500), "human-a", 1000, key=key) == key
+    assert (await vault.load(key)).token == "synthetic-access-a"
