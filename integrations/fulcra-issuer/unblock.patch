+    async def load_refresh_token(self, client, refresh_token):
+        if not isinstance(refresh_token, str) or not re.fullmatch(
+            r"uaa-refresh-[a-f0-9]{64}", refresh_token
+        ):
+            return None
+        observed = await self._read(state_key("refresh", refresh_token))
+        if observed is None:
+            return None
+        row = observed[0]
+        binding = row["binding"]
+        if binding["client_id"] != client.client_id:
+            return None
+        if (
+            row["status"] == "completed"
+            and self.now() > row["result"]["rotated_at"] + REFRESH_RETRY_SECONDS
+        ):
+            return None
+        return ResourceRefreshToken(
+            token=refresh_token,
+            client_id=client.client_id,
+            scopes=binding["scopes"],
+            expires_at=row["expires_at"],
+            resource=binding["resource"],
+        )
+
+    async def exchange_refresh_token(self, client, refresh_token, scopes):
+        key = state_key("refresh", refresh_token.token)
+        row, _ = await self._required(key)
+        binding = row["binding"]
+        root = binding["root_code_key"]
+        if binding["client_id"] != client.client_id or scopes != [WORKER_SCOPE]:
+            raise TokenError("invalid_scope", "worker scope cannot change")
+        await self._active(root)
+        if row["status"] == "completed":
+            if self.now() > row["result"]["rotated_at"] + REFRESH_RETRY_SECONDS:
+                raise TokenError("invalid_grant", "refresh retry window ended")
+            return self._replacement(row)
+        # Resume only the frozen native effect. Owner custody may supply known
+        # access, but recovery must never take over an upstream refresh.
+        if row["status"] in ("claimed", "uncertain"):
+            checkpoints = row.get("checkpoints", {})
+            try:
+                receipt_data = checkpoints.get("native_receipt")
+                if receipt_data is None:
+                    intent = checkpoints.get("native_intent")
+                    if (
+                        not intent
+                        or intent.get("renewal_of") != binding["current_grant_id"]
+                    ):
+                        raise BridgeUnavailable("renewal intent unavailable")
+                    owner = await self.vault.load(
+                        binding["owner_key"], allow_refresh=False
+                    )
+                    receipt = await self.bridge.reconcile_enrollment(
+                        ProjectBinding(**binding["project"]), owner, intent
+                    )
+                    if receipt is None:
+                        raise BridgeUnavailable("renewal receipt remains unknown")
+                    await self._active(root)
+                    await self._checkpoint(
+                        key, row["claim_id"], "native_receipt", asdict(receipt)
+                    )
+                else:
+                    receipt = NativeGrantReceipt(**receipt_data)
+                return await self._materialize(
+                    key, row["claim_id"], binding, receipt, initial=False
+                )
+            except Exception:
+                raise TokenError(
+                    "invalid_grant", "refresh recovery remains unresolved"
+                ) from None
+        if row["status"] != "pending":
+            raise TokenError("invalid_grant", "refresh effect is unresolved; reconnect")
+        claim = secrets.token_hex(16)
+        try:
+            await asyncio.to_thread(self.transactions.claim, key, claim)
+        except Exception:
+            raise TokenError("invalid_grant", "refresh claim unavailable") from None
+        phase = "owner_access"
+        try:
+            owner = await self.vault.load(binding["owner_key"])
+            project = ProjectBinding(**binding["project"])
+            intent = await self.bridge.prepare_enrollment(
+                project,
+                owner,
+                "uaa-renew-" + secrets.token_hex(32),
+                renewal_of=binding["current_grant_id"],
+            )
+            await self._checkpoint(key, claim, "native_intent", intent)
+            await self._active(root)
+            phase = "native_enrollment"
+            receipt = await self.bridge.enroll_worker(project, owner, intent)
+            await self._checkpoint(key, claim, "native_receipt", asdict(receipt))
+            phase = "token_publication"
+            return await self._materialize(key, claim, binding, receipt, initial=False)
+        except Exception:
+            await self._uncertain(key, claim, phase)
+            raise TokenError(
+                "invalid_grant",
+                "refresh outcome is pending recovery; reconnect if requested",
+            ) from None
+
+    async def load_access_token(self, token):
+        if not isinstance(token, str) or not token or len(token) > 20000:
+            return None
+        observed = await self._read(state_key("access", token))
+        if observed is None:
+            return None
+        row = observed[0]
+        # Metadata is used only by this branch's authenticated revocation
+        # handler. It is never inserted in the original MCP token namespace.
+        return AccessToken(
+            token=token,
+            client_id=row["client_id"],
+            scopes=row["scopes"],
+            expires_at=row["expires_at"],
+            resource=row["resource"],
+            subject=row["subject"],
+        )
+
+    async def revoke_token(self, token):
+        kind = "refresh" if isinstance(token, ResourceRefreshToken) else "access"
+        row, _ = await self._required(state_key(kind, token.token))
+        root = (
+            row["binding"]["root_code_key"]
+            if kind == "refresh"
+            else row["root_code_key"]
+        )
+        if not await self._request_revocation(root):
+            raise BridgeUnavailable("revocation remains pending source readback")
+
+    async def _request_revocation(self, root):
+        for _ in range(5):
+            row, generation = await self._required(root)
+            if row.get("revocation_requested"):
+                break
+            try:
+                await asyncio.to_thread(
+                    self.store.replace,
+                    root,
+                    {**row, "revocation_requested": True},
+                    generation,
+                )
+                break
+            except StateConflict:
+                continue
+            except Exception:
+                observed, _ = await self._required(root)
+                if not observed.get("revocation_requested"):
+                    raise BridgeUnavailable(
+                        "revocation request publication unresolved"
+                    ) from None
+                break
+        else:
+            raise BridgeUnavailable("revocation request conflicted")
+        await self.vault.request_revocation(row["binding"]["owner_key"])
+        return await self.recover_pending_code(root)
+
+    async def recover_pending_code(self, root):
+        """Private operator/replay recovery; never a public unauthenticated API."""
+        row, _ = await self._required(root)
+        if not row.get("revocation_requested"):
+            return False
+        binding, checkpoints = row["binding"], row.get("checkpoints", {})
+        cleanup_key = state_key("revoke", root)
+        cleanup = await self._read(cleanup_key)
+        if cleanup and cleanup[0]["status"] == "completed":
+            try:
+                await self.vault.disable(binding["owner_key"])
+                return True
+            except Exception:
+                return False
+        if not checkpoints.get("native_intent"):
+            await self.vault.disable(binding["owner_key"])
+            return True  # No native effect can precede its durable intent.
+        try:
+            owner = await self.vault.load(binding["owner_key"], for_revocation=True)
+            project = ProjectBinding(**binding["project"])
+            if cleanup is None:
+                receipt = (
+                    NativeGrantReceipt(**checkpoints["native_receipt"])
+                    if checkpoints.get("native_receipt")
+                    else await self.bridge.reconcile_enrollment(
+                        project, owner, checkpoints["native_intent"]
+                    )
+                )
+                if receipt is None:
+                    return False
+                frozen = {
+                    "owner_key": binding["owner_key"],
+                    "grant_id": receipt.grant_id,
+                    "intent_id": "uaa-revoke-" + root.split("/")[1],
+                    "project": binding["project"],
+                }
+                await self._begin(cleanup_key, frozen, int(self.now()) + LOGIN_SECONDS)
+                cleanup = await self._required(cleanup_key)
+            # Once revocation was frozen, its grant ID is the recovery source.
+            # Re-enrollment lookup can correctly deny an already revoked grant.
+            cleanup_row = cleanup[0]
+            frozen = cleanup_row["binding"]
+            if cleanup_row["status"] == "pending":
+                claim = secrets.token_hex(16)
+                await asyncio.to_thread(self.transactions.claim, cleanup_key, claim)
+                try:
+                    await self.bridge.revoke_worker(
+                        project, owner, frozen["grant_id"], frozen["intent_id"]
+                    )
+                except Exception:
+                    await self._uncertain(cleanup_key, claim, "native_revocation")
+            else:
+                claim = cleanup_row["claim_id"]
+            if not await self.bridge.revocation_observed(
+                project, owner, frozen["grant_id"]
+            ):
+                return False
+            await self._finish(
+                cleanup_key,
+                claim,
+                "completed",
+                {"grant_id": frozen["grant_id"], "source": "checked"},
+            )
+            await self.vault.disable(binding["owner_key"])
+            return True
+        except Exception:
+            return False  # The durable request/intent remains pending, never quiet.
