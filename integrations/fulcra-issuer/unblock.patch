+        try:
+            await asyncio.to_thread(self.transactions.claim, key, claim)
+        except StateConflict:
+            raise BridgeRejected("consent already processed") from None
+        code = "uaa-code-" + secrets.token_hex(32)
+        code_key = state_key("code", code)
+        code_binding = {
+            k: binding[k]
+            for k in (
+                "client_id",
+                "redirect_uri",
+                "redirect_explicit",
+                "challenge",
+                "scopes",
+                "resource",
+                "owner_key",
+                "session_expires_at",
+            )
+        }
+        code_binding.update(project=asdict(project), root_code_key=code_key)
+        try:
+            await self._checkpoint(
+                key,
+                claim,
+                "authorization_code",
+                {"code": code, "binding": code_binding},
+            )
