+async def approve(provider, consent_id, secret, agent="worker-a"):
+    url = await provider.approve_consent(
+        consent_id, secret, agent=agent, environment="env", name=agent
+    )
+    return parse_qs(urlsplit(url).query)["code"][0], parse_qs(urlsplit(url).query)[
+        "state"
+    ][0]
+
