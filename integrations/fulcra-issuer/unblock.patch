+"""Local probe harness tests; actual GCS acceptance stays separate."""
+
+import json
+from pathlib import Path
+
+import pytest
+from google.api_core.exceptions import Forbidden, PreconditionFailed
+from test_unblock_state import Backend, Blob
+from fulcra_mcp.unblock_probe import run_probe, main
+
+RUN = "11111111-1111-4111-a111-111111111111"
+PREFIX = "unblock-acceptance/pilot"
+
+
+@pytest.fixture
+def backend(monkeypatch):
+    value = Backend()
+
+    def delete(blob, *, if_generation_match, timeout, retry):
+        with blob.backend.lock:
+            row = blob.backend.records.get(blob.name)
+            if row is None or row[1] != if_generation_match:
+                raise PreconditionFailed("changed")
+            del blob.backend.records[blob.name]
+
+    monkeypatch.setattr(Blob, "delete", delete, raising=False)
+    return value
+
+
+def test_two_clients_actual_adapter_probe_cas_claim_and_cleanup(backend):
+    calls = []
+
+    def client():
+        calls.append(True)
+        return backend
+
+    report = run_probe(client, PREFIX, RUN)
+    assert len(calls) == 2
+    assert report["status"] == "passed"
+    assert all(report["checks"].values()) and len(report["checks"]) == 5
+    assert report["cleanup_pending"] == [] and backend.records == {}
+    assert all(
+        name.startswith(PREFIX + "/" + RUN + "/unblock/v1/")
+        for name in report["objects"]
+    )
+
+
+@pytest.mark.parametrize(
+    "prefix", ["unblock/v1", "../pilot", "unblock-acceptance/pilot/../x", ""]
+)
+def test_invalid_scope_rejected_before_client_discovery(prefix):
+    def forbidden():
+        pytest.fail("invalid prefix discovered credentials")
+
+    with pytest.raises(ValueError):
+        run_probe(forbidden, prefix, RUN)
+
+
+def test_unavailable_source_keeps_cleanup_unknown(backend):
+    backend.unavailable = True
+    report = run_probe(lambda: backend, PREFIX, RUN)
+    assert report["status"] == "unresolved"
+    assert len(report["cleanup_pending"]) == 2
+    assert "synthetic-sensitive-value" not in json.dumps(report)
+
+
+def test_lost_successful_create_response_cleans_only_its_own_objects(
+    backend, monkeypatch
+):
+    original = Blob.upload_from_string
+
+    def lost(blob, *args, **kwargs):
+        original(blob, *args, **kwargs)
+        raise OSError("private-credential-must-not-print")
+
+    monkeypatch.setattr(Blob, "upload_from_string", lost)
+    report = run_probe(lambda: backend, PREFIX, RUN)
+    assert report["status"] == "failed"
+    assert report["cleanup_pending"] == [] and not backend.records
+    assert "private-credential" not in json.dumps(report)
+
+
+def test_foreign_marker_is_not_deleted_and_cleanup_remains_pending(
+    backend, monkeypatch
+):
+    original = Blob.upload_from_string
+
+    def foreign(blob, data, **kwargs):
+        original(blob, json.dumps({"probe_run_id": "another-run"}), **kwargs)
+        raise OSError("lost")
+
+    monkeypatch.setattr(Blob, "upload_from_string", foreign)
+    report = run_probe(lambda: backend, PREFIX, RUN)
+    assert report["status"] == "unresolved" and len(report["cleanup_pending"]) == 1
+    assert len(backend.records) == 1
+
+
+def test_conditional_cleanup_failure_never_reports_pass(backend, monkeypatch):
+    def fail(*args, **kwargs):
+        raise Forbidden("private failure")
+
+    monkeypatch.setattr(Blob, "delete", fail)
+    report = run_probe(lambda: backend, PREFIX, RUN)
+    assert report["status"] == "unresolved" and len(report["cleanup_pending"]) == 2
+    assert len(backend.records) == 2
+
+
+def test_cli_records_private_intent_before_discovering_clients(tmp_path, monkeypatch):
+    import fulcra_mcp.unblock_probe as module
+
+    path = tmp_path / "report.json"
+
+    def factory(bucket):
+        state = json.loads(path.read_text())
+        assert state["status"] == "prepared" and state["bucket"] == "authorized-test"
+        assert path.stat().st_mode & 0o777 == 0o600
+        raise OSError("not authorized here")
+
+    monkeypatch.setattr(module, "bucket_factory", factory)
+    assert (
+        main(["--bucket", "authorized-test", "--prefix", PREFIX, "--report", str(path)])
+        != 0
+    )
+    assert json.loads(path.read_text())["status"] != "passed"
+    with pytest.raises(FileExistsError):
+        main(["--bucket", "authorized-test", "--prefix", PREFIX, "--report", str(path)])
+
+
+def test_explicit_cleanup_resumes_retained_objects_without_new_probe(
+    backend, tmp_path, monkeypatch
+):
+    import fulcra_mcp.unblock_probe as module
+    from fulcra_mcp.unblock_ops_report import write_report
+
+    original = Blob.delete
+    monkeypatch.setattr(
+        Blob, "delete", lambda *a, **kw: (_ for _ in ()).throw(OSError("lost"))
+    )
+    report = run_probe(lambda: backend, PREFIX, RUN)
+    report["bucket"] = "authorized-test"
+    path = tmp_path / "report.json"
+    write_report(path, report, create=True)
+    monkeypatch.setattr(Blob, "delete", original)
+    monkeypatch.setattr(module, "bucket_factory", lambda name: lambda: backend)
+    assert (
+        main(
+            [
+                "--bucket",
+                "authorized-test",
+                "--prefix",
+                PREFIX,
+                "--report",
+                str(path),
+                "--cleanup-only",
+            ]
+        )
+        == 0
+    )
+    observed = json.loads(path.read_text())
+    assert (
+        observed["status"] == "cleanup_complete"
+        and observed["prior_status"] == "unresolved"
+    )
+    assert not backend.records
+
+
+def test_cleanup_rejects_changed_target_and_public_or_symlink_report(
+    tmp_path, monkeypatch
+):
+    import fulcra_mcp.unblock_probe as module
+    from fulcra_mcp.unblock_ops_report import write_report
+
+    path = tmp_path / "report.json"
+    write_report(
+        path,
+        {"bucket": "original-bucket", "prefix": PREFIX, "run_id": RUN},
+        create=True,
+    )
+    monkeypatch.setattr(
+        module,
+        "bucket_factory",
+        lambda name: pytest.fail("invalid cleanup discovered credentials"),
+    )
+    with pytest.raises(ValueError):
+        main(
+            [
+                "--bucket",
+                "another-bucket",
+                "--prefix",
+                PREFIX,
+                "--report",
+                str(path),
+                "--cleanup-only",
+            ]
+        )
+    path.chmod(0o644)
+    with pytest.raises(ValueError):
+        main(
+            [
+                "--bucket",
+                "original-bucket",
+                "--prefix",
+                PREFIX,
+                "--report",
+                str(path),
+                "--cleanup-only",
+            ]
+        )
+    link = tmp_path / "link.json"
+    link.symlink_to(path)
+    with pytest.raises(OSError):
+        main(
+            [
+                "--bucket",
+                "original-bucket",
+                "--prefix",
+                PREFIX,
+                "--report",
+                str(link),
+                "--cleanup-only",
+            ]
+        )
+
+
+def test_lost_successful_delete_response_is_settled_by_exact_absence(
+    backend, monkeypatch
+):
+    original = Blob.delete
+
+    def lost(blob, **kwargs):
+        original(blob, **kwargs)
+        raise OSError("response lost after delete")
+
+    monkeypatch.setattr(Blob, "delete", lost)
+    report = run_probe(lambda: backend, PREFIX, RUN)
+    assert report["status"] == "passed" and not report["cleanup_pending"]
+    assert not backend.records
+
+
+def test_cleanup_generation_race_preserves_the_changed_object(backend, monkeypatch):
+    original = Blob.delete
+    armed = [True]
+
+    def changed(blob, **kwargs):
+        if armed[0]:
+            armed[0] = False
+            with backend.lock:
+                backend.records[blob.name] = (
+                    b'{"probe_run_id":"another-run"}',
