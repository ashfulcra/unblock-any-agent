+    async def authorize(self, client, params):
+        try:
+            resource = _resource(params.resource)
+            if (
+                self.allowed_resources is not None
+                and resource not in self.allowed_resources
+            ):
+                raise BridgeRejected("resource is outside this rollout")
+            if (
+                params.scopes != [WORKER_SCOPE]
+                or not re.fullmatch(r"[A-Za-z0-9_-]{43}", params.code_challenge)
+                or (params.state is not None and len(params.state) > 4096)
