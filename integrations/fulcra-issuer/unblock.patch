+            return await asyncio.to_thread(
+                self.transactions.finish, key, claim, status, result
+            )
+        except Exception:
+            observed = await self._read(key)
+            if (
+                observed is not None
+                and observed[0].get("claim_id") == claim
+                and observed[0].get("status") == status
+                and observed[0].get("result") == result
+            ):
+                return observed
+            raise BridgeUnavailable(
+                "authorization outcome publication unresolved"
+            ) from None
