index 0000000..ec79c4c
--- /dev/null
+++ b/fulcra_mcp/unblock_ops_report.py
@@ -0,0 +1,65 @@
+"""Private, atomic operator reports. They never contain bearer material."""
+
+import json
+import os
+import stat
+import tempfile
+from pathlib import Path
+
+
+def sync_directory(path):
+    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+def write_report(path, value, *, create=False):
+    path = Path(path)
+    raw = (json.dumps(value, indent=2, allow_nan=False) + "\n").encode()
+    if create:
+        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+        with os.fdopen(fd, "wb") as stream:
+            stream.write(raw)
+            stream.flush()
+            os.fsync(stream.fileno())
+        sync_directory(path.parent)
+        return
+    info = path.lstat()
+    if (
+        not stat.S_ISREG(info.st_mode)
+        or info.st_uid != os.getuid()
+        or info.st_mode & 0o077
+    ):
+        raise ValueError("private regular report required")
+    fd, temporary = tempfile.mkstemp(prefix=".unblock-report-", dir=path.parent)
+    try:
+        with os.fdopen(fd, "wb") as stream:
+            stream.write(raw)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary, path)
+        sync_directory(path.parent)
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
+
+def read_report(path):
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
+    with os.fdopen(fd, "rb") as stream:
+        info = os.fstat(stream.fileno())
+        if (
+            not stat.S_ISREG(info.st_mode)
+            or info.st_uid != os.getuid()
+            or info.st_mode & 0o077
+        ):
+            raise ValueError("private regular report required")
+        raw = stream.read(65537)
+        if len(raw) > 65536:
+            raise ValueError("report too large")
+        value = json.loads(raw)
+        if not isinstance(value, dict):
+            raise ValueError("invalid report")
+        return value
diff --git a/fulcra_mcp/unblock_owner.py b/fulcra_mcp/unblock_owner.py
new file mode 100644
index 0000000..12eb108
--- /dev/null
+++ b/fulcra_mcp/unblock_owner.py
@@ -0,0 +1,252 @@
+"""Private owner credential custody and one-time upstream refresh claims."""
+
+import asyncio
+import hashlib
+import secrets
+import time
+
+from fulcra_api.core import FulcraAPI
+from fulcra_api.credentials import FulcraCredentials
+
+from .settings import settings
+from .unblock_bridge import OwnerAccess, BridgeRejected, BridgeUnavailable
+from .unblock_state import StateStore, StateConflict, state_key
+
+OWNER_SESSION_SECONDS = 86400
+
+
+async def refresh_owner(credentials):
+    def perform():
+        api = FulcraAPI(
+            oidc_client_id=settings.oidc_client_id,
+            oidc_domain=settings.fulcra_oidc_domain,
+            oidc_audience=settings.fulcra_api,
+            credentials=credentials,
+        )
+        if not api.refresh_access_token() or api.fulcra_credentials is None:
+            raise BridgeUnavailable("upstream refresh outcome unavailable")
+        return api.fulcra_credentials
+
+    return await asyncio.to_thread(perform)
+
+
+class OwnerVault:
+    def __init__(self, store: StateStore, *, refresh=refresh_owner, now=time.time):
+        self.store, self.refresh, self.now = store, refresh, now
+
+    async def _read(self, key):
+        try:
+            observed = await asyncio.to_thread(self.store.read, key)
+        except Exception:
+            raise BridgeUnavailable("owner credential source unavailable") from None
+        if observed is None:
+            raise BridgeUnavailable("owner credential record unavailable")
+        row, generation = observed
+        if (
+            not isinstance(row.get("subject"), str)
+            or not row["subject"]
+            or type(row.get("expires_at")) is not int
+            or type(row.get("revision")) is not int
+            or row.get("refresh_state")
+            not in ("ready", "claimed", "uncertain", "revoked")
+            or type(row.get("revoked")) is not bool
+            or type(row.get("revocation_requested")) is not bool
+        ):
+            raise BridgeUnavailable("owner credential source malformed")
+        return row, generation
+
+    def _credentials(self, row):
+        try:
+            credentials = FulcraCredentials.from_json(row["credentials"])
+            if (
+                not credentials.access_token
+                or credentials.access_token_expiration is None
+            ):
+                raise ValueError("missing access")
+            expiry = int(credentials.access_token_expiration.timestamp())
+            return credentials, expiry
+        except Exception:
+            raise BridgeUnavailable("owner credentials malformed") from None
+
+    async def save(self, credentials, subject, expires_at, *, key=None):
+        if (
+            not isinstance(subject, str)
+            or not subject
+            or len(subject) > 200
+            or type(expires_at) is not int
+            or not self.now() < expires_at <= self.now() + OWNER_SESSION_SECONDS
+        ):
+            raise BridgeRejected("invalid bounded owner session")
+        serialized = credentials.to_json()
+        _, access_expiry = self._credentials({"credentials": serialized})
+        if access_expiry <= self.now():
+            raise BridgeRejected("owner authentication expired")
+        key = key or state_key("owner", secrets.token_urlsafe(32))
+        if not isinstance(key, str) or not key.startswith("owner/"):
+            raise BridgeRejected("invalid frozen owner reference")
+        row = {
+            "subject": subject,
+            "expires_at": expires_at,
+            "revision": 0,
+            "credentials": serialized,
+            "refresh_state": "ready",
+            "refresh_claim": None,
+            "last_refresh_claim": None,
+            "revoked": False,
+            "revocation_requested": False,
+            "refresh_history": [],
+        }
+        try:
+            await asyncio.to_thread(self.store.create, key, row)
+        except Exception:
+            # The caller may freeze this reference before the effect. A lost
+            # conditional-create response is accepted only after exact readback.
+            observed, _ = await self._read(key)
+            if observed != row:
+                raise BridgeUnavailable(
+                    "owner credential persistence unresolved"
+                ) from None
+        return key
+
+    async def _flag(self, key, **changes):
+        for _ in range(5):
+            row, generation = await self._read(key)
+            updated = {**row, **changes}
+            try:
+                await asyncio.to_thread(self.store.replace, key, updated, generation)
+                return
+            except StateConflict:
+                continue
+            except Exception:
+                raise BridgeUnavailable(
+                    "owner credential transition unavailable"
+                ) from None
+        raise BridgeUnavailable("owner credential transition conflicted")
+
+    async def request_revocation(self, key):
+        await self._flag(key, revocation_requested=True)
+
+    async def disable(self, key):
+        # Only the controller calls this after grant revocation readback, or
+        # after declining a flow which has issued no native grant.
+        await self._flag(
+            key,
+            revocation_requested=True,
+            revoked=True,
+            credentials=None,
+            refresh_state="revoked",
+        )
+
+    async def _uncertain(self, key, claim_id):
+        for _ in range(3):
+            try:
+                row, generation = await self._read(key)
+                if row.get("refresh_claim") != claim_id or row["revoked"]:
+                    return
+                updated = {**row, "refresh_state": "uncertain"}
+                await asyncio.to_thread(self.store.replace, key, updated, generation)
+                return
+            except StateConflict:
+                continue
+            except Exception:
+                # The durable claim already prevents another refresh. An
+                # unavailable uncertainty annotation cannot permit takeover.
+                return
+
+    async def _persist_refresh(self, key, claim_id, revision, credentials):
+        serialized = credentials.to_json()
+        for _ in range(5):
+            row, generation = await self._read(key)
+            if row["revoked"]:
+                raise BridgeRejected("owner session revoked")
+            if (
+                row.get("last_refresh_claim") == claim_id
+                and row["revision"] == revision + 1
+            ):
+                if row.get("credentials") != serialized:
+                    raise BridgeUnavailable("owner refresh receipts conflict")
+                return row
+            if row.get("refresh_claim") != claim_id or row["revision"] != revision:
+                raise BridgeUnavailable("owner refresh claim changed")
+            updated = {
+                **row,
+                "credentials": serialized,
+                "revision": revision + 1,
+                "refresh_state": "ready",
+                "refresh_claim": None,
+                "last_refresh_claim": claim_id,
+                "refresh_history": row.get("refresh_history", [])
+                + [
+                    {"claim_id": claim_id, "status": "completed", "at": int(self.now())}
+                ],
+            }
+            try:
+                await asyncio.to_thread(self.store.replace, key, updated, generation)
+                return updated
+            except StateConflict:
+                continue
+            except Exception:
+                # Re-read first: a lost conditional-write response may already
+                # have stored this exact refresh receipt. Never refresh again.
+                observed, _ = await self._read(key)
+                if (
+                    observed.get("last_refresh_claim") == claim_id
+                    and observed.get("credentials") == serialized
+                ):
+                    return observed
+                raise BridgeUnavailable(
+                    "owner refresh persistence unresolved"
+                ) from None
+        raise BridgeUnavailable("owner refresh persistence conflicted")
+
+    async def load(self, key, *, for_revocation=False, allow_refresh=True):
+        row, generation = await self._read(key)
+        if row["revoked"] or row["expires_at"] <= self.now():
+            raise BridgeRejected("owner session ended")
+        if row["revocation_requested"] and not for_revocation:
+            raise BridgeRejected("owner session revocation requested")
+        if row["refresh_state"] != "ready":
+            raise BridgeUnavailable("upstream refresh unresolved; reconnect required")
+        credentials, expiry = self._credentials(row)
+        if expiry - self.now() > 120 or (
+            (for_revocation or not allow_refresh) and expiry > self.now()
+        ):
+            return OwnerAccess(credentials.access_token, min(expiry, row["expires_at"]))
+        if not allow_refresh or for_revocation or not credentials.refresh_token:
+            raise BridgeRejected("owner reconnect required")
+        claim_id = secrets.token_urlsafe(32)
+        claimed = {
+            **row,
+            "refresh_state": "claimed",
+            "refresh_claim": claim_id,
+            "refresh_intent": {
+                "claim_id": claim_id,
+                "revision": row["revision"],
+                "credential_sha256": hashlib.sha256(
+                    row["credentials"].encode()
+                ).hexdigest(),
+                "at": int(self.now()),
+            },
+        }
+        try:
+            await asyncio.to_thread(self.store.replace, key, claimed, generation)
+        except Exception:
+            raise BridgeUnavailable("upstream refresh claim unresolved") from None
+        try:
+            replacement = await self.refresh(credentials)
+            _, new_expiry = self._credentials({"credentials": replacement.to_json()})
+            if new_expiry <= self.now() + 120:
+                raise BridgeUnavailable("upstream refresh receipt unusable")
+        except Exception:
+            await self._uncertain(key, claim_id)
+            raise BridgeUnavailable(
+                "upstream refresh outcome unknown; reconnect required"
+            ) from None
+        updated = await self._persist_refresh(
+            key, claim_id, row["revision"], replacement
+        )
+        if updated["revocation_requested"] and not for_revocation:
+            raise BridgeRejected("owner session revocation requested")
+        return OwnerAccess(
+            replacement.access_token, min(new_expiry, updated["expires_at"])
+        )
diff --git a/fulcra_mcp/unblock_probe.py b/fulcra_mcp/unblock_probe.py
new file mode 100644
index 0000000..0f8e2dd
--- /dev/null
+++ b/fulcra_mcp/unblock_probe.py
@@ -0,0 +1,236 @@
+"""Explicit disposable GCS acceptance probe, separate from live issuer state."""
+
+import argparse
+import json
+import re
+import threading
+import time
+import uuid
+from concurrent.futures import ThreadPoolExecutor
+
+from google.cloud import storage
+from google.cloud.storage.retry import DEFAULT_RETRY_IF_GENERATION_SPECIFIED
+
+from .unblock_ops_report import write_report, read_report
+from .unblock_state import (
+    StateStore,
+    Transactions,
+    StateConflict,
+    state_key,
+    TIMEOUT_SECONDS,
+)
+
+
+def scope(prefix, run_id):
+    if not isinstance(prefix, str) or not re.fullmatch(
+        r"unblock-acceptance/[a-z][a-z0-9-]{0,47}", prefix
+    ):
+        raise ValueError("dedicated unblock-acceptance prefix required")
+    if str(uuid.UUID(run_id)) != run_id:
+        raise ValueError("canonical probe UUID required")
+    return prefix + "/" + run_id + "/"
+
+
+def keys(run_id):
+    return [state_key("probe", run_id + ":cas"), state_key("code", run_id + ":claim")]
+
+
+class ProbeBucket:
+    def __init__(self, bucket, prefix, run_id):
+        self.bucket, self.prefix, self.run_id = bucket, scope(prefix, run_id), run_id
+
+    def blob(self, name):
+        if name not in ["unblock/v1/" + key for key in keys(self.run_id)]:
+            raise ValueError("object outside frozen probe scope")
+        return self.bucket.blob(self.prefix + name)
+
+    def exists(self, **kwargs):
+        return self.bucket.exists(**kwargs)
+
+
+def cleanup(bucket, prefix, run_id):
+    wrapped = ProbeBucket(bucket, prefix, run_id)
+    store, pending = StateStore(wrapped), []
+    for key in keys(run_id):
+        name = wrapped.prefix + "unblock/v1/" + key
+        try:
+            observed = store.read(key)
+            if observed is None:
+                continue
+            row, generation = observed
+            if (
+                row.get("probe_run_id", row.get("binding", {}).get("probe_run_id"))
+                != run_id
+            ):
+                raise ValueError("probe ownership changed")
+            try:
+                wrapped.blob("unblock/v1/" + key).delete(
+                    if_generation_match=generation,
+                    timeout=TIMEOUT_SECONDS,
+                    retry=DEFAULT_RETRY_IF_GENERATION_SPECIFIED,
+                )
+            except Exception:
+                # A lost response can follow deletion; read exact absence first.
+                if store.read(key) is not None:
+                    raise
+            if store.read(key) is not None:
+                raise ValueError("cleanup not observed")
+        except Exception:
+            pending.append(name)
+    return pending
+
+
+def run_probe(bucket_factory, prefix, run_id):
+    root = scope(prefix, run_id)
+    key, transaction_key = keys(run_id)
+    report = {
+        "status": "failed",
+        "run_id": run_id,
+        "prefix": prefix,
+        "objects": [root + "unblock/v1/" + key for key in keys(run_id)],
+        "checks": {},
+        "cleanup_pending": [],
+    }
+    buckets = []
+    try:
+        buckets = [bucket_factory(), bucket_factory()]
+        first, second = [
+            StateStore(ProbeBucket(bucket, prefix, run_id)) for bucket in buckets
+        ]
+        generation = first.create(key, {"probe_run_id": run_id, "winner": None})
+        try:
+            second.create(key, {"probe_run_id": run_id, "winner": "unexpected"})
+        except StateConflict:
+            report["checks"]["conditional_create"] = True
+        if not report["checks"].get("conditional_create"):
+            raise ValueError("conditional create did not conflict")
+        barrier = threading.Barrier(2)
+
+        def replace(store, winner):
+            barrier.wait(timeout=10)
+            try:
+                expected = {"probe_run_id": run_id, "winner": winner}
+                store.replace(key, expected, generation)
+                return expected
+            except StateConflict:
+                return None
+
+        with ThreadPoolExecutor(2) as pool:
+            futures = [
+                pool.submit(replace, store, str(i))
+                for i, store in enumerate([first, second])
+            ]
+            winners = [
+                result for future in futures if (result := future.result()) is not None
+            ]
+            report["checks"]["one_cas_winner"] = (
+                len(winners) == 1
+                and first.read(key)[0] == winners[0]
+                and second.read(key)[0] == winners[0]
+            )
+        try:
+            second.replace(key, {"probe_run_id": run_id, "winner": "stale"}, generation)
+        except StateConflict:
+            report["checks"]["stale_replace_denied"] = True
+        transactions = [Transactions(store) for store in [first, second]]
+        transactions[0].begin(
+            transaction_key, {"probe_run_id": run_id}, int(time.time()) + 120
+        )
+
+        def claim(index):
+            try:
+                expected, _ = transactions[index].claim(
+                    transaction_key, "claim-" + str(index)
+                )
+                return expected
+            except StateConflict:
+                return None
+
+        with ThreadPoolExecutor(2) as pool:
+            futures = [pool.submit(claim, i) for i in range(2)]
+            claims = [
+                result for future in futures if (result := future.result()) is not None
+            ]
+            report["checks"]["one_transaction_claim"] = len(claims) == 1
+        report["checks"]["replacement_readback"] = (
+            len(claims) == 1
+            and second.read(transaction_key)[0] == claims[0]
+            and first.read(transaction_key)[0] == claims[0]
+        )
+        if len(report["checks"]) == 5 and all(report["checks"].values()):
+            report["status"] = "passed"
+    except Exception:
+        report["failure"] = "probe_checks_unresolved_or_failed"
+    finally:
+        report["cleanup_pending"] = (
+            cleanup(buckets[0], prefix, run_id) if buckets else report["objects"]
+        )
+        if report["cleanup_pending"]:
+            report["status"] = "unresolved"
+    return report
+
+
+def bucket_factory(name):
+    return lambda: storage.Client().bucket(name)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--bucket", required=True)
+    parser.add_argument("--prefix", required=True)
+    parser.add_argument("--report", required=True)
+    parser.add_argument("--cleanup-only", action="store_true")
+    args = parser.parse_args(argv)
+    if not re.fullmatch(r"[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]", args.bucket):
+        parser.error("explicit bucket name required")
+    if args.cleanup_only:
+        retained = read_report(args.report)
+        if (
+            retained.get("bucket") != args.bucket
+            or retained.get("prefix") != args.prefix
+        ):
+            raise ValueError("cleanup target differs from frozen report")
+        run_id = retained["run_id"]
+        root = scope(args.prefix, run_id)
+        names = [root + "unblock/v1/" + key for key in keys(run_id)]
+        if retained.get("objects") != names:
+            raise ValueError("cleanup object manifest differs")
+        try:
+            pending = cleanup(bucket_factory(args.bucket)(), args.prefix, run_id)
+        except Exception:
+            pending = names
+        report = {
+            **retained,
+            "prior_status": retained.get("prior_status", retained["status"]),
+            "status": "unresolved" if pending else "cleanup_complete",
+            "cleanup_pending": pending,
+        }
+        write_report(args.report, report)
+        print(json.dumps({"status": report["status"], "private_report": args.report}))
+        return 1 if pending else 0
+    run_id = str(uuid.uuid4())
+    root = scope(args.prefix, run_id)
+    prepared = {
+        "status": "prepared",
+        "bucket": args.bucket,
+        "run_id": run_id,
+        "prefix": args.prefix,
+        "objects": [root + "unblock/v1/" + key for key in keys(run_id)],
+    }
+    write_report(args.report, prepared, create=True)
+    try:
+        report = run_probe(bucket_factory(args.bucket), args.prefix, run_id)
+    except Exception:
+        report = {
+            **prepared,
+            "status": "unresolved",
+            "cleanup_pending": prepared["objects"],
+        }
+    report["bucket"] = args.bucket
+    write_report(args.report, report)
+    print(json.dumps({"status": report["status"], "private_report": args.report}))
+    return 0 if report["status"] == "passed" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/fulcra_mcp/unblock_provider.py b/fulcra_mcp/unblock_provider.py
new file mode 100644
index 0000000..c53632d
--- /dev/null
+++ b/fulcra_mcp/unblock_provider.py
@@ -0,0 +1,894 @@
+"""An isolated, optional OAuth issuer branch for one approved native worker.
+
+This module neither mounts routes nor discovers credentials at import. The
+original Fulcra OAuth provider and its token namespace remain independent.
+"""
+
+import asyncio
+import base64
+import hashlib
+import hmac
+import re
+import secrets
+import time
+from dataclasses import asdict
+from urllib.parse import urlsplit
+
+from fulcra_api.core import FulcraAPI
+from mcp.server.auth.provider import (
+    AccessToken,
+    AuthorizationCode,
+    AuthorizeError,
+    RefreshToken,
+    RegistrationError,
+    TokenError,
+    construct_redirect_uri,
+)
+from mcp.shared.auth import OAuthClientInformationFull, OAuthToken
+from pydantic import AnyUrl
+from .unblock_resource import parse_resource
+
+from .settings import settings
+from .unblock_bridge import (
+    OwnerAccess,
+    ProjectBinding,
+    NativeGrantReceipt,
+    BridgeRejected,
+    BridgeUnavailable,
+    validate_saved_project,
+    validate_saved_intent,
+)
+from .unblock_owner import OWNER_SESSION_SECONDS
+from .unblock_state import Transactions, StateConflict, state_key
+
+WORKER_SCOPE = "unblock:worker"
+LOGIN_SECONDS = 600
+CODE_SECONDS = 120
+REFRESH_RETRY_SECONDS = 120
+
+
+def saved_root_enrollment_valid(row, root):
+    """Check retained initial enrollment authority before inspection or cleanup.
+
+    Pending roots may precede an enrollment intent. A receipt or completed
+    publication can never precede it. Refresh enrollment intents belong to
+    separate refresh records and must not replace an initial code's intent.
+    """
+    try:
+        binding, checkpoints = row["binding"], row["checkpoints"]
+        project = ProjectBinding(**binding["project"])
+        validate_saved_project(project)
+        if (
+            binding["root_code_key"] != root or project.resource != binding["resource"]
+            or not isinstance(binding["owner_key"], str)
+            or re.fullmatch(r"owner/[a-f0-9]{64}", binding["owner_key"]) is None
+            or type(binding["session_expires_at"]) is not int
+            or binding["session_expires_at"] <= 0
+            or not isinstance(checkpoints, dict)
+        ):
+            return False
+        if "native_intent" not in checkpoints:
+            return row["status"] != "completed" and "native_receipt" not in checkpoints
+        intent = checkpoints["native_intent"]
+        validate_saved_intent(project, intent)
+        return intent["renewal_of"] is None and intent["expires_at"] <= binding["session_expires_at"]
+    except (KeyError, TypeError, ValueError, AttributeError, BridgeRejected):
+        return False
+
+
+class ResourceRefreshToken(RefreshToken):
+    resource: str
+
+
+def _resource(value):
+    try:
+        parts = urlsplit(value)
+        if (
+            not isinstance(value, str)
+            or len(value) > 2048
+            or parts.scheme != "https"
+            or not re.fullmatch(
+                r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.my\.fulcra\.ai",
+                parts.hostname or "",
+            )
+            or value != "https://" + parts.hostname + "/mcp"
+        ):
+            raise ValueError("not canonical")
+    except (TypeError, ValueError):
+        raise BridgeRejected(
+            "a canonical owned Fulcra dashboard resource is required"
+        ) from None
+    return value
+
+
+def upstream_api():
+    return FulcraAPI(
+        oidc_client_id=settings.oidc_client_id,
+        oidc_domain=settings.fulcra_oidc_domain,
+        oidc_audience=settings.fulcra_api,
+    )
+
+
+class UnblockProvider:
+    def __init__(
+        self,
+        store,
+        bridge,
+        vault,
+        *,
+        issuer_origin,
+        upstream_factory=upstream_api,
+        now=time.time,
+        allowed_resources=(),
+    ):
+        parts = urlsplit(issuer_origin)
+        if (
+            parts.scheme != "https"
+            or not parts.hostname
+            or parts.username
+            or parts.password
+            or parts.path not in ("", "/")
+            or parts.query
+            or parts.fragment
+            or parts.port not in (None, 443)
+        ):
+            raise ValueError("trusted HTTPS issuer origin required")
+        self.store, self.bridge, self.vault = store, bridge, vault
+        self.origin, self.now = issuer_origin.rstrip("/"), now
+        self.upstream_factory = upstream_factory
+        self.allowed_resources = (
+            None
+            if allowed_resources is None
+            else frozenset(_resource(value) for value in allowed_resources)
+        )
+        self.transactions = Transactions(store, now=now)
+
