+    async def _request_revocation(self, root):
+        for _ in range(5):
+            row, generation = await self._required(root)
+            if row.get("revocation_requested"):
+                break
+            try:
+                await asyncio.to_thread(
+                    self.store.replace,
+                    root,
+                    {**row, "revocation_requested": True},
+                    generation,
+                )
+                break
+            except StateConflict:
+                continue
+            except Exception:
+                observed, _ = await self._required(root)
+                if not observed.get("revocation_requested"):
+                    raise BridgeUnavailable(
+                        "revocation request publication unresolved"
+                    ) from None
+                break
+        else:
+            raise BridgeUnavailable("revocation request conflicted")
+        await self.vault.request_revocation(row["binding"]["owner_key"])
+        return await self.recover_pending_code(root)
+
+    async def recover_pending_code(self, root, *, expected_resource=None):
+        """Private operator/replay recovery; never a public unauthenticated API."""
+        row, _ = await self._required(root)
+        if (
+            expected_resource is not None
+            and row["binding"].get("resource") != expected_resource
+        ):
+            return False
+        if not row.get("revocation_requested") or not saved_root_enrollment_valid(row, root):
+            return False
+        binding, checkpoints = row["binding"], row.get("checkpoints", {})
+        cleanup_key = state_key("revoke", root)
+        cleanup = await self._read(cleanup_key)
+        if cleanup and cleanup[0]["status"] == "completed":
+            try:
+                await self.vault.disable(binding["owner_key"])
+                return True
+            except Exception:
+                return False
+        if not checkpoints.get("native_intent"):
+            await self.vault.disable(binding["owner_key"])
+            return True  # No native effect can precede its durable intent.
+        try:
+            owner = await self.vault.load(binding["owner_key"], for_revocation=True)
+            project = ProjectBinding(**binding["project"])
+            if cleanup is None:
+                receipt = (
+                    NativeGrantReceipt(**checkpoints["native_receipt"])
+                    if checkpoints.get("native_receipt")
+                    else await self.bridge.reconcile_enrollment(
+                        project, owner, checkpoints["native_intent"]
+                    )
+                )
+                if receipt is None:
+                    return False
+                frozen = {
+                    "owner_key": binding["owner_key"],
+                    "grant_id": receipt.grant_id,
+                    "intent_id": "uaa-revoke-" + root.split("/")[1],
+                    "project": binding["project"],
+                }
+                await self._begin(cleanup_key, frozen, int(self.now()) + LOGIN_SECONDS)
+                cleanup = await self._required(cleanup_key)
+            # Once revocation was frozen, its grant ID is the recovery source.
+            # Re-enrollment lookup can correctly deny an already revoked grant.
+            cleanup_row = cleanup[0]
+            frozen = cleanup_row["binding"]
+            if cleanup_row["status"] == "pending":
+                claim = secrets.token_hex(16)
+                await asyncio.to_thread(self.transactions.claim, cleanup_key, claim)
+                try:
+                    await self.bridge.revoke_worker(
+                        project, owner, frozen["grant_id"], frozen["intent_id"]
+                    )
+                except Exception:
+                    await self._uncertain(cleanup_key, claim, "native_revocation")
+            else:
+                claim = cleanup_row["claim_id"]
+            if not await self.bridge.revocation_observed(
+                project, owner, frozen["grant_id"]
+            ):
+                return False
+            await self._finish(
+                cleanup_key,
+                claim,
+                "completed",
+                {"grant_id": frozen["grant_id"], "source": "checked"},
+            )
+            await self.vault.disable(binding["owner_key"])
+            return True
+        except Exception:
+            return False  # The durable request/intent remains pending, never quiet.
