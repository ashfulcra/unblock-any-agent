@@ -0,0 +1,402 @@
+"""Real OAuth HTTP routes, cookie/CSRF rules, and private-consent rendering."""
+
+import re
+from urllib.parse import parse_qs, urlsplit
+
+import httpx
+import pytest
+from starlette.applications import Starlette
+from starlette.routing import Route
+from test_unblock_provider import context, VERIFIER, CHALLENGE, RESOURCE_A
+from fulcra_mcp.unblock_consent import (
+    create_unblock_routes,
+    callback_response,
+    optional_provider,
+)
+
+
+async def session(provider):
+    async def callback(request):
+        return await callback_response(request, provider)
+
+    app = Starlette(
+        routes=[Route("/callback", callback)] + create_unblock_routes(provider)
+    )
+    return httpx.AsyncClient(
+        transport=httpx.ASGITransport(app),
+        base_url="https://issuer.invalid",
+        follow_redirects=False,
+    )
+
+
+async def start(client, *, auth_method="client_secret_post"):
+    registered = await client.post(
+        "/unblock/register",
+        json={
+            "redirect_uris": ["https://client.invalid/callback"],
+            "client_name": "<script>untrusted</script>",
+            "token_endpoint_auth_method": auth_method,
+            "grant_types": ["authorization_code", "refresh_token"],
+            "scope": "unblock:worker",
+        },
+    )
+    assert registered.status_code == 201
+    registration = registered.json()
+    auth = await client.get(
+        "/unblock/authorize",
+        params={
+            "response_type": "code",
+            "client_id": registration["client_id"],
+            "redirect_uri": "https://client.invalid/callback",
+            "scope": "unblock:worker",
+            "code_challenge": CHALLENGE,
+            "code_challenge_method": "S256",
+            "resource": RESOURCE_A,
+            "state": "exact-client-state",
+        },
+    )
+    assert auth.status_code == 302
+    state = parse_qs(urlsplit(auth.headers["location"]).query)["state"][0]
+    callback = await client.get("/callback", params={"state": state, "code": "a"})
+    assert callback.status_code == 302
+    return registration, state, callback
+
+
+async def test_metadata_routes_describe_the_actual_isolated_branch(context):
+    provider = context[4]
+    async with await session(provider) as client:
+        response = await client.get("/.well-known/oauth-authorization-server/unblock")
+        assert response.status_code == 200
+        metadata = response.json()
+        assert metadata["issuer"] == "https://issuer.invalid/unblock"
+        assert metadata["token_endpoint"] == "https://issuer.invalid/unblock/token"
+        assert (
+            metadata["authorization_endpoint"]
+            == "https://issuer.invalid/unblock/authorize"
+        )
+        assert (
+            metadata["registration_endpoint"]
+            == "https://issuer.invalid/unblock/register"
+        )
+        assert metadata["scopes_supported"] == ["unblock:worker"]
+
+
+async def test_real_dcr_consent_cookie_and_token_exchange(context):
+    bridge, provider = context[2], context[4]
+    async with await session(provider) as client:
+        registration, state, callback = await start(client)
+        cookie = callback.headers["set-cookie"]
+        assert (
+            "__Host-unblock-" in cookie
+            and "Secure" in cookie
+            and "HttpOnly" in cookie
+            and "SameSite=lax" in cookie
+            and "Path=/" in cookie
+        )
+        location = callback.headers["location"]
+        consent = await client.get(location)
+        assert consent.status_code == 200
+        assert "<script>untrusted</script>" not in consent.text
+        assert "&lt;script&gt;untrusted&lt;/script&gt;" in consent.text
+        assert (
+            "synthetic-access" not in consent.text
+            and "synthetic-owner-refresh" not in consent.text
+        )
+        assert consent.headers["cache-control"] == "no-store"
+        assert "frame-ancestors 'none'" in consent.headers["content-security-policy"]
+        assert bridge.grants == {}
+        csrf = re.search(r'name="csrf" value="([^"]+)"', consent.text).group(1)
+        form = {
+            "csrf": csrf,
+            "decision": "approve",
+            "agent": "worker-a",
+            "environment": "env",
+            "name": "Worker A",
+        }
+        denied = await client.post(
+            location, data=form, headers={"Origin": "https://evil.invalid"}
+        )
+        assert denied.status_code == 403 and bridge.grants == {}
+        approved = await client.post(
+            location, data=form, headers={"Origin": "https://issuer.invalid"}
+        )
+        assert approved.status_code == 302
+        returned = parse_qs(urlsplit(approved.headers["location"]).query)
+        assert returned["state"] == ["exact-client-state"]
+        assert bridge.grants == {}
+        response = await client.post(
+            "/unblock/token",
+            data={
+                "grant_type": "authorization_code",
+                "code": returned["code"][0],
+                "code_verifier": VERIFIER,
+                "resource": RESOURCE_A,
+                "redirect_uri": "https://client.invalid/callback",
+                "client_id": registration["client_id"],
+                "client_secret": registration["client_secret"],
+            },
+        )
+        assert response.status_code == 200
+        assert response.json()["access_token"].startswith("synthetic-native-")
+        assert response.json()["scope"] == "unblock:worker"
+        assert len(bridge.grants) == 1
+        replay = await client.get("/callback", params={"state": state, "code": "a"})
+        assert replay.status_code == 400
+
+
+async def test_decline_and_wrong_cookie_do_not_grant_worker_access(context):
+    bridge, provider = context[2], context[4]
+    async with await session(provider) as client:
+        _, _, callback = await start(client)
+        location = callback.headers["location"]
+        page = await client.get(location)
+        csrf = re.search(r'name="csrf" value="([^"]+)"', page.text).group(1)
+        async with await session(provider) as stranger:
+            assert (await stranger.get(location)).status_code == 400
+            assert (
+                await stranger.post(
+                    location,
+                    data={
+                        "csrf": csrf,
+                        "decision": "approve",
+                        "agent": "bad",
+                        "environment": "env",
+                        "name": "bad",
+                    },
+                    headers={"Origin": "https://issuer.invalid"},
+                )
+            ).status_code == 403
+        response = await client.post(
+            location,
+            data={
+                "csrf": csrf,
+                "decision": "deny",
+                "agent": "",
+                "environment": "",
+                "name": "",
+            },
+            headers={"Origin": "https://issuer.invalid"},
+        )
+        assert response.status_code == 302
+        assert parse_qs(urlsplit(response.headers["location"]).query)["error"] == [
+            "access_denied"
+        ]
+        assert bridge.grants == {}
+
+
+async def test_duplicate_resource_and_large_bodies_fail_before_authorization(context):
+    provider = context[4]
+    async with await session(provider) as client:
+        response = await client.get(
+            "/unblock/authorize?resource=" + RESOURCE_A + "&resource=" + RESOURCE_A
+        )
+        assert response.status_code == 400
+        response = await client.post(
+            "/unblock/register",
+            content=b"x" * 65537,
+            headers={"content-type": "application/json"},
+        )
+        assert response.status_code == 413
+
+
+def test_disabled_or_unconfigured_branch_discovers_no_credentials(monkeypatch):
+    import fulcra_mcp.unblock_consent as module
+
+    monkeypatch.setattr(module.settings, "unblock_enabled", False)
+
+    def forbidden():
+        pytest.fail("disabled branch must not discover credentials")
+
+    monkeypatch.setattr(module, "configured_store", forbidden)
+    assert optional_provider() is None
+    monkeypatch.setattr(module.settings, "unblock_enabled", True)
+    monkeypatch.setattr(module.settings, "state_bucket", None)
+    assert optional_provider() is None
+
+
+async def connected(client, *, auth_method="client_secret_post"):
+    registration, _, callback = await start(client, auth_method=auth_method)
+    location = callback.headers["location"]
+    page = await client.get(location)
+    csrf = re.search(r'name="csrf" value="([^"]+)"', page.text).group(1)
+    approved = await client.post(
+        location,
+        data={
+            "csrf": csrf,
+            "decision": "approve",
+            "agent": "worker-a",
+            "environment": "env",
+            "name": "Worker A",
+        },
+        headers={"Origin": "https://issuer.invalid"},
+    )
+    code = parse_qs(urlsplit(approved.headers["location"]).query)["code"][0]
+    token = await client.post(
+        "/unblock/token",
+        data={
+            "grant_type": "authorization_code",
+            "code": code,
+            "code_verifier": VERIFIER,
+            "resource": RESOURCE_A,
+            "redirect_uri": "https://client.invalid/callback",
+            "client_id": registration["client_id"],
+            **(
+                {"client_secret": registration["client_secret"]}
+                if registration.get("client_secret")
+                else {}
+            ),
+        },
+    )
+    assert token.status_code == 200
+    return registration, token.json()
+
+
+async def test_revocation_does_not_report_success_before_actual_readback(context):
+    bridge, provider = context[2], context[4]
+    async with await session(provider) as client:
+        registration, tokens = await connected(client)
+        bridge.lose_revocation = True
+        bridge.lose_revocation_readback = True
+        body = {
+            "token": tokens["access_token"],
+            "client_id": registration["client_id"],
+            "client_secret": registration["client_secret"],
+        }
+        assert (await client.post("/unblock/revoke", data=body)).status_code == 503
+        assert (await client.post("/unblock/revoke", data=body)).status_code == 200
+        assert bridge.revoked
+
+
+async def test_another_oauth_client_cannot_revoke_this_connection(context):
+    bridge, provider = context[2], context[4]
+    async with await session(provider) as client:
+        _, tokens = await connected(client)
+        stranger = (
+            await client.post(
+                "/unblock/register",
+                json={
+                    "redirect_uris": ["https://another.invalid/callback"],
+                    "grant_types": ["authorization_code", "refresh_token"],
+                    "scope": "unblock:worker",
+                },
+            )
+        ).json()
+        assert (
+            await client.post(
+                "/unblock/revoke",
+                data={
+                    "token": tokens["access_token"],
+                    "client_id": stranger["client_id"],
+                    "client_secret": stranger["client_secret"],
+                },
+            )
+        ).status_code == 200
+        assert not bridge.revoked
+
+
+async def test_existing_registered_callback_dispatches_new_persistent_state(
+    context, monkeypatch
+):
+    import fulcra_mcp.main as main
+    from test_unblock_provider import CLIENT, CHALLENGE
+    from mcp.server.auth.provider import AuthorizationParams
+
+    provider = context[4]
+    monkeypatch.setattr(main, "unblock_provider", provider)
+    params = AuthorizationParams(
+        state="caller",
+        scopes=["unblock:worker"],
+        code_challenge=CHALLENGE,
+        redirect_uri="https://client.invalid/callback",
+        redirect_uri_provided_explicitly=True,
+        resource=RESOURCE_A,
+    )
+    url = await provider.authorize(CLIENT, params)
+    state = parse_qs(urlsplit(url).query)["state"][0]
+    async with httpx.AsyncClient(
+        transport=httpx.ASGITransport(main.app), base_url="https://issuer.invalid"
+    ) as client:
+        response = await client.get("/callback", params={"state": state, "code": "a"})
+    assert response.status_code == 302
+    assert "/unblock/consent/" in response.headers["location"]
+
+
+async def test_original_callback_state_keeps_its_existing_route(context, monkeypatch):
+    import fulcra_mcp.main as main
+
+    provider = context[4]
+    monkeypatch.setattr(main, "unblock_provider", provider)
+    state = "uaa-login-" + "a" * 64
+    monkeypatch.setitem(main.oauth_provider.state_mapping, state, {"original": True})
+
+    async def original(code, observed_state):
+        assert (code, observed_state) == ("original-code", state)
+        return "https://client.invalid/original"
+
+    monkeypatch.setattr(main.oauth_provider, "handle_callback", original)
+    async with httpx.AsyncClient(
+        transport=httpx.ASGITransport(main.app), base_url="https://issuer.invalid"
+    ) as client:
+        response = await client.get(
+            "/callback", params={"state": state, "code": "original-code"}
+        )
+    assert response.status_code == 302
+    assert response.headers["location"] == "https://client.invalid/original"
+
+
+def test_enabling_without_a_pilot_or_public_resource_policy_never_discovers_credentials(
+    monkeypatch,
+):
+    import fulcra_mcp.unblock_consent as module
+
+    monkeypatch.setattr(module.settings, "unblock_enabled", True)
+    monkeypatch.setattr(module.settings, "state_bucket", "synthetic-bucket")
+    monkeypatch.setattr(module.settings, "oidc_client_id", "existing-client")
+    monkeypatch.setattr(module.settings, "fulcra_oidc_domain", "auth.invalid")
+    monkeypatch.setattr(module.settings, "fulcra_api", "https://api.invalid")
+    monkeypatch.setattr(module.settings, "unblock_resources", [])
+    monkeypatch.setattr(module.settings, "unblock_allow_owned_resources", False)
+
+    def forbidden():
