+"""Private owner credential custody and one-time upstream refresh claims."""
+
+import asyncio
+import hashlib
+import secrets
+import time
+
+from fulcra_api.core import FulcraAPI
+from fulcra_api.credentials import FulcraCredentials
+
+from .settings import settings
+from .unblock_bridge import OwnerAccess, BridgeRejected, BridgeUnavailable
+from .unblock_state import StateStore, StateConflict, state_key
+
+OWNER_SESSION_SECONDS = 86400
+
+
+async def refresh_owner(credentials):
+    def perform():
+        api = FulcraAPI(
+            oidc_client_id=settings.oidc_client_id,
+            oidc_domain=settings.fulcra_oidc_domain,
+            oidc_audience=settings.fulcra_api,
+            credentials=credentials,
+        )
+        if not api.refresh_access_token() or api.fulcra_credentials is None:
+            raise BridgeUnavailable("upstream refresh outcome unavailable")
+        return api.fulcra_credentials
+
+    return await asyncio.to_thread(perform)
+
+
+class OwnerVault:
+    def __init__(self, store: StateStore, *, refresh=refresh_owner, now=time.time):
+        self.store, self.refresh, self.now = store, refresh, now
+
+    async def _read(self, key):
+        try:
+            observed = await asyncio.to_thread(self.store.read, key)
+        except Exception:
+            raise BridgeUnavailable("owner credential source unavailable") from None
+        if observed is None:
+            raise BridgeUnavailable("owner credential record unavailable")
+        row, generation = observed
+        if (
+            not isinstance(row.get("subject"), str)
+            or not row["subject"]
+            or type(row.get("expires_at")) is not int
+            or type(row.get("revision")) is not int
+            or row.get("refresh_state")
+            not in ("ready", "claimed", "uncertain", "revoked")
+            or type(row.get("revoked")) is not bool
+            or type(row.get("revocation_requested")) is not bool
+        ):
+            raise BridgeUnavailable("owner credential source malformed")
+        return row, generation
+
+    def _credentials(self, row):
+        try:
+            credentials = FulcraCredentials.from_json(row["credentials"])
+            if (
+                not credentials.access_token
+                or credentials.access_token_expiration is None
+            ):
+                raise ValueError("missing access")
+            expiry = int(credentials.access_token_expiration.timestamp())
+            return credentials, expiry
+        except Exception:
+            raise BridgeUnavailable("owner credentials malformed") from None
+
+    async def save(self, credentials, subject, expires_at, *, key=None):
+        if (
+            not isinstance(subject, str)
+            or not subject
+            or len(subject) > 200
+            or type(expires_at) is not int
+            or not self.now() < expires_at <= self.now() + OWNER_SESSION_SECONDS
+        ):
+            raise BridgeRejected("invalid bounded owner session")
+        serialized = credentials.to_json()
+        _, access_expiry = self._credentials({"credentials": serialized})
+        if access_expiry <= self.now():
+            raise BridgeRejected("owner authentication expired")
+        key = key or state_key("owner", secrets.token_urlsafe(32))
+        if not isinstance(key, str) or not key.startswith("owner/"):
+            raise BridgeRejected("invalid frozen owner reference")
+        row = {
+            "subject": subject,
+            "expires_at": expires_at,
+            "revision": 0,
+            "credentials": serialized,
+            "refresh_state": "ready",
+            "refresh_claim": None,
+            "last_refresh_claim": None,
+            "revoked": False,
+            "revocation_requested": False,
+            "refresh_history": [],
+        }
+        try:
+            await asyncio.to_thread(self.store.create, key, row)
+        except Exception:
+            # The caller may freeze this reference before the effect. A lost
+            # conditional-create response is accepted only after exact readback.
+            observed, _ = await self._read(key)
+            if observed != row:
+                raise BridgeUnavailable(
+                    "owner credential persistence unresolved"
+                ) from None
+        return key
+
+    async def _flag(self, key, **changes):
+        for _ in range(5):
+            row, generation = await self._read(key)
+            updated = {**row, **changes}
+            try:
+                await asyncio.to_thread(self.store.replace, key, updated, generation)
+                return
+            except StateConflict:
+                continue
+            except Exception:
+                raise BridgeUnavailable(
+                    "owner credential transition unavailable"
+                ) from None
+        raise BridgeUnavailable("owner credential transition conflicted")
+
+    async def request_revocation(self, key):
+        await self._flag(key, revocation_requested=True)
+
+    async def disable(self, key):
+        # Only the controller calls this after grant revocation readback, or
+        # after declining a flow which has issued no native grant.
+        await self._flag(
+            key,
+            revocation_requested=True,
+            revoked=True,
+            credentials=None,
+            refresh_state="revoked",
+        )
+
+    async def _uncertain(self, key, claim_id):
+        for _ in range(3):
+            try:
+                row, generation = await self._read(key)
+                if row.get("refresh_claim") != claim_id or row["revoked"]:
+                    return
+                updated = {**row, "refresh_state": "uncertain"}
+                await asyncio.to_thread(self.store.replace, key, updated, generation)
+                return
+            except StateConflict:
+                continue
+            except Exception:
+                # The durable claim already prevents another refresh. An
+                # unavailable uncertainty annotation cannot permit takeover.
+                return
+
+    async def _persist_refresh(self, key, claim_id, revision, credentials):
+        serialized = credentials.to_json()
+        for _ in range(5):
+            row, generation = await self._read(key)
+            if row["revoked"]:
+                raise BridgeRejected("owner session revoked")
+            if (
+                row.get("last_refresh_claim") == claim_id
+                and row["revision"] == revision + 1
+            ):
+                if row.get("credentials") != serialized:
+                    raise BridgeUnavailable("owner refresh receipts conflict")
+                return row
+            if row.get("refresh_claim") != claim_id or row["revision"] != revision:
+                raise BridgeUnavailable("owner refresh claim changed")
+            updated = {
+                **row,
+                "credentials": serialized,
+                "revision": revision + 1,
+                "refresh_state": "ready",
+                "refresh_claim": None,
+                "last_refresh_claim": claim_id,
+                "refresh_history": row.get("refresh_history", [])
+                + [
+                    {"claim_id": claim_id, "status": "completed", "at": int(self.now())}
+                ],
+            }
+            try:
+                await asyncio.to_thread(self.store.replace, key, updated, generation)
+                return updated
+            except StateConflict:
+                continue
+            except Exception:
+                # Re-read first: a lost conditional-write response may already
+                # have stored this exact refresh receipt. Never refresh again.
+                observed, _ = await self._read(key)
+                if (
+                    observed.get("last_refresh_claim") == claim_id
+                    and observed.get("credentials") == serialized
+                ):
+                    return observed
+                raise BridgeUnavailable(
+                    "owner refresh persistence unresolved"
+                ) from None
+        raise BridgeUnavailable("owner refresh persistence conflicted")
+
+    async def load(self, key, *, for_revocation=False, allow_refresh=True):
+        row, generation = await self._read(key)
+        if row["revoked"] or row["expires_at"] <= self.now():
+            raise BridgeRejected("owner session ended")
+        if row["revocation_requested"] and not for_revocation:
+            raise BridgeRejected("owner session revocation requested")
+        if row["refresh_state"] != "ready":
+            raise BridgeUnavailable("upstream refresh unresolved; reconnect required")
+        credentials, expiry = self._credentials(row)
+        if expiry - self.now() > 120 or (
+            (for_revocation or not allow_refresh) and expiry > self.now()
+        ):
+            return OwnerAccess(credentials.access_token, min(expiry, row["expires_at"]))
+        if not allow_refresh or for_revocation or not credentials.refresh_token:
+            raise BridgeRejected("owner reconnect required")
+        claim_id = secrets.token_urlsafe(32)
+        claimed = {
+            **row,
+            "refresh_state": "claimed",
+            "refresh_claim": claim_id,
+            "refresh_intent": {
+                "claim_id": claim_id,
+                "revision": row["revision"],
+                "credential_sha256": hashlib.sha256(
+                    row["credentials"].encode()
+                ).hexdigest(),
+                "at": int(self.now()),
+            },
+        }
+        try:
+            await asyncio.to_thread(self.store.replace, key, claimed, generation)
+        except Exception:
+            raise BridgeUnavailable("upstream refresh claim unresolved") from None
+        try:
+            replacement = await self.refresh(credentials)
+            _, new_expiry = self._credentials({"credentials": replacement.to_json()})
+            if new_expiry <= self.now() + 120:
+                raise BridgeUnavailable("upstream refresh receipt unusable")
+        except Exception:
+            await self._uncertain(key, claim_id)
+            raise BridgeUnavailable(
+                "upstream refresh outcome unknown; reconnect required"
+            ) from None
+        updated = await self._persist_refresh(
+            key, claim_id, row["revision"], replacement
+        )
+        if updated["revocation_requested"] and not for_revocation:
+            raise BridgeRejected("owner session revocation requested")
+        return OwnerAccess(
+            replacement.access_token, min(new_expiry, updated["expires_at"])
+        )
