+"""Generation-aware fake GCS boundary; this is not a live bucket probe."""
+
+import json
+import threading
+from concurrent.futures import ThreadPoolExecutor
+
+import pytest
+from google.api_core.exceptions import Forbidden, NotFound, PreconditionFailed
+
+from fulcra_mcp.unblock_state import (
+    StateStore,
+    Transactions,
+    StateConflict,
+    StateUnavailable,
+    StateInvalid,
+    configured_store,
+    state_key,
+)
+
+
+class Backend:
+    def __init__(self):
+        self.lock = threading.Lock()
+        self.records = {}
+        self.next_generation = 1
+        self.before_download = None
+        self.unavailable = False
+        self.calls = 0
+        self.hide_upload_generation = False
+
+    def blob(self, name):
+        return Blob(self, name)
+
+    def exists(self, *, timeout):
+        return not self.unavailable
+
+
+class Blob:
+    def __init__(self, backend, name):
+        self.backend, self.name, self.generation = backend, name, None
+
+    def reload(self, *, timeout):
+        with self.backend.lock:
+            self.backend.calls += 1
+            if self.backend.unavailable:
+                raise Forbidden("synthetic-sensitive-value")
+            if self.name not in self.backend.records:
+                raise NotFound("missing")
+            self.generation = self.backend.records[self.name][1]
+
+    def download_as_bytes(self, *, if_generation_match, timeout, retry):
+        if self.backend.before_download:
+            action, self.backend.before_download = self.backend.before_download, None
+            action()
+        with self.backend.lock:
+            raw, generation = self.backend.records[self.name]
+            if generation != if_generation_match:
+                raise PreconditionFailed("changed generation")
+            return raw
+
+    def upload_from_string(
+        self, data, *, content_type, if_generation_match, timeout, retry
+    ):
+        assert content_type == "application/json"
+        with self.backend.lock:
+            self.backend.calls += 1
+            if self.backend.unavailable:
+                raise Forbidden("synthetic-sensitive-value")
+            old = self.backend.records.get(self.name)
+            if (old[1] if old else 0) != if_generation_match:
+                raise PreconditionFailed("changed generation")
+            generation = self.backend.next_generation
+            self.backend.next_generation += 1
+            self.backend.records[self.name] = (
+                data.encode() if isinstance(data, str) else data,
+                generation,
+            )
+            self.generation = (
+                None if self.backend.hide_upload_generation else generation
+            )
+
+
+@pytest.fixture
+def stores():
+    backend = Backend()
+    return backend, StateStore(backend), StateStore(backend)
+
+
+KEY = state_key("code", "synthetic-secret-not-in-object-name")
+BINDING = {
+    "subject": "human-a",
+    "client_id": "client",
+    "resource": "https://a.invalid/mcp",
+}
+
+
+def test_create_read_replace_survive_a_different_instance(stores):
+    backend, first, replacement = stores
+    generation = first.create(KEY, {"status": "pending", "binding": BINDING})
+    row, read_generation = replacement.read(KEY)
+    assert row["binding"]["subject"] == "human-a"
+    assert read_generation == generation
+    replacement.replace(KEY, {**row, "status": "claimed"}, generation)
+    assert first.read(KEY)[0]["status"] == "claimed"
+    assert all(
+        "synthetic-secret-not-in-object-name" not in name for name in backend.records
+    )
+
+
+def test_create_does_not_overwrite_and_stale_replace_loses(stores):
+    _, first, second = stores
+    generation = first.create(KEY, {"winner": "first"})
+    with pytest.raises(StateConflict):
+        second.create(KEY, {"winner": "second"})
+    first.replace(KEY, {"winner": "new"}, generation)
+    with pytest.raises(StateConflict):
+        second.replace(KEY, {"winner": "stale"}, generation)
+    assert second.read(KEY)[0] == {"winner": "new"}
+
+
+def test_two_clients_cannot_both_win_the_same_generation(stores):
+    _, first, second = stores
+    generation = first.create(KEY, {"winner": None})
+    barrier = threading.Barrier(2)
+
+    def attempt(store, name):
+        barrier.wait()
+        try:
+            store.replace(KEY, {"winner": name}, generation)
+            return True
+        except StateConflict:
+            return False
+
+    with ThreadPoolExecutor(2) as pool:
+        results = [pool.submit(attempt, first, "a"), pool.submit(attempt, second, "b")]
+        assert sorted(f.result() for f in results) == [False, True]
+    assert first.read(KEY)[0]["winner"] in ["a", "b"]
+
+
+def test_read_cannot_combine_old_metadata_with_changed_bytes(stores):
+    backend, first, second = stores
+    generation = first.create(KEY, {"version": "old"})
+    backend.before_download = lambda: second.replace(
+        KEY, {"version": "new"}, generation
+    )
+    with pytest.raises(StateConflict):
+        first.read(KEY)
+    assert first.read(KEY)[0] == {"version": "new"}
+
+
+def test_unavailable_source_is_not_an_empty_state_or_a_secret_error(stores):
+    backend, first, _ = stores
+    backend.unavailable = True
+    with pytest.raises(StateUnavailable) as caught:
+        first.read(KEY)
+    assert "synthetic-sensitive-value" not in str(caught.value)
+
+
+@pytest.mark.parametrize("key", ["../secret", "code/raw-token", "/code/" + "a" * 64])
+def test_invalid_keys_never_reach_storage(stores, key):
+    backend, first, _ = stores
+    with pytest.raises(StateInvalid):
+        first.create(key, {"x": 1})
+    assert backend.calls == 0
+
+
+def test_missing_bucket_configuration_fails_before_adc(monkeypatch):
+    from fulcra_mcp import unblock_state
+
+    monkeypatch.setattr(unblock_state.settings, "state_bucket", None)
+
+    def adc_is_not_authorized():
+        pytest.fail(
+            "must not discover ambient credentials without bucket configuration"
+        )
+
+    monkeypatch.setattr(unblock_state.storage, "Client", adc_is_not_authorized)
+    with pytest.raises(StateUnavailable):
+        configured_store()
+
+
+def test_unknown_upload_result_is_retained_and_can_be_read(stores):
+    backend, first, second = stores
+    backend.hide_upload_generation = True
+    with pytest.raises(StateUnavailable):
+        first.create(KEY, {"intent": "retained"})
+    assert second.read(KEY)[0] == {"intent": "retained"}
+
+
+def test_expired_transaction_is_retained_but_cannot_be_claimed(stores):
+    _, store, _ = stores
+    clock = [100]
+    transactions = Transactions(store, now=lambda: clock[0])
+    transactions.begin(KEY, BINDING, 120)
+    clock[0] = 121
+    with pytest.raises(StateConflict):
+        transactions.claim(KEY, "claim-a")
+    assert store.read(KEY)[0]["status"] == "pending"
+
+
+def test_same_client_two_humans_keep_separate_transactions(stores):
+    _, store, other_store = stores
+    a, b = (
+        Transactions(store, now=lambda: 100),
+        Transactions(other_store, now=lambda: 100),
+    )
+    second_key = state_key("code", "second-human-secret")
+    a.begin(KEY, BINDING, 200)
+    b.begin(second_key, {**BINDING, "subject": "human-b"}, 200)
+    a.claim(KEY, "claim-a")
+    b.claim(second_key, "claim-b")
+    assert store.read(KEY)[0]["binding"]["subject"] == "human-a"
+    assert store.read(second_key)[0]["binding"]["subject"] == "human-b"
+
+
+def test_claim_is_one_time_across_instances(stores):
+    _, store, other = stores
+    a, b = Transactions(store, now=lambda: 100), Transactions(other, now=lambda: 100)
+    a.begin(KEY, BINDING, 200)
+    a.claim(KEY, "claim-a")
+    with pytest.raises(StateConflict):
+        b.claim(KEY, "claim-b")
+    assert store.read(KEY)[0]["claim_id"] == "claim-a"
+
+
+def test_uncertain_effect_cannot_be_reclaimed_and_checked_settlement_preserves_history(
+    stores,
+):
+    _, store, other = stores
+    clock = [100]
+    a = Transactions(store, now=lambda: clock[0])
+    a.begin(KEY, BINDING, 120)
+    a.claim(KEY, "claim-a")
+    a.finish(KEY, "claim-a", "uncertain", {"intent": "enrollment-1", "receipt": None})
+    clock[0] = 500
+    b = Transactions(other, now=lambda: clock[0])
+    with pytest.raises(StateConflict):
+        b.claim(KEY, "claim-b")
+    b.finish(
+        KEY, "claim-a", "completed", {"intent": "enrollment-1", "receipt": "verified"}
+    )
+    row = store.read(KEY)[0]
+    assert row["result"]["receipt"] == "verified"
+    assert row["history"][-2]["result"]["receipt"] is None
+    assert row["binding"] == BINDING
+
+
+def test_finish_retry_is_exact_and_cannot_change_a_completed_result(stores):
+    _, store, _ = stores
+    transactions = Transactions(store, now=lambda: 100)
+    transactions.begin(KEY, BINDING, 200)
+    transactions.claim(KEY, "claim-a")
+    transactions.finish(KEY, "claim-a", "completed", {"grant": "one"})
+    before = store.read(KEY)
+    transactions.finish(KEY, "claim-a", "completed", {"grant": "one"})
+    assert store.read(KEY) == before
+    with pytest.raises(StateConflict):
+        transactions.finish(KEY, "claim-a", "completed", {"grant": "two"})
+    with pytest.raises(StateConflict):
+        transactions.finish(KEY, "claim-b", "completed", {"grant": "one"})
+    assert store.read(KEY) == before
+
+
+def test_malformed_source_is_unavailable_not_missing(stores):
+    backend, store, _ = stores
+    store.create(KEY, {"valid": True})
+    name = next(iter(backend.records))
+    backend.records[name] = (b"[]", backend.records[name][1])
+    with pytest.raises(StateUnavailable):
+        store.read(KEY)
