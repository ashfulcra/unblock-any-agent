+    assert (
+        recovered["access_token"]
+        == bridge.grants[frozen_intent["intent_id"]][2].credential
+    )
+    assert len(bridge.grants) == 2 and store.read(key)[0]["status"] == "completed"
+
+
+async def test_unknown_renewal_retains_intent_without_reenrollment(
+    context, monkeypatch
+):
+    from fulcra_mcp.unblock_state import state_key
+
+    _, store, bridge, _, provider, replacement = context
+    code, _ = await approve(provider, *await login(provider))
+    first = (await token(provider, code=code))[1]
+    bridge.lose_enrollment = True
+    assert (await token(provider, refresh=first["refresh_token"]))[0] == 400
+    key = state_key("refresh", first["refresh_token"])
+    before = store.read(key)[0]
+
+    async def unknown(*args):
+        return None
+
+    monkeypatch.setattr(bridge, "reconcile_enrollment", unknown)
+    assert (await token(replacement(), refresh=first["refresh_token"]))[0] == 400
+    assert store.read(key)[0] == before and len(bridge.grants) == 2
