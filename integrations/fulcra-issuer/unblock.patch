new file mode 100644
index 0000000..3b58bd8
--- /dev/null
+++ b/tests/test_unblock_resource.py
@@ -0,0 +1,182 @@
+"""Resource substitution must never reach an external token-issuance effect."""
+
+import asyncio
+import base64
+import hashlib
+import json
+import time
+from urllib.parse import urlencode
+
+import pytest
+from fulcra_mcp.unblock_resource import ResourceTokenHandler
+from mcp.server.auth.provider import AuthorizationCode, RefreshToken
+from mcp.shared.auth import OAuthClientInformationFull, OAuthToken
+from starlette.requests import Request
+
+RESOURCE = "https://dashboard.invalid/mcp"
+OTHER = "https://other.invalid/mcp"
+VERIFIER = "v" * 43
+CHALLENGE = (
+    base64.urlsafe_b64encode(hashlib.sha256(VERIFIER.encode()).digest())
+    .decode()
+    .rstrip("=")
+)
+CLIENT = OAuthClientInformationFull(
+    client_id="test-client",
+    redirect_uris=["https://client.invalid/callback"],
+    grant_types=["authorization_code", "refresh_token"],
+)
+
+
+class BoundRefresh(RefreshToken):
+    resource: str | None = RESOURCE
+
+
+class Authenticator:
+    async def authenticate_request(self, request):
+        return CLIENT
+
+
+class Provider:
+    def __init__(self, bound=RESOURCE):
+        self.bound = bound
+        self.effects = []
+
+    async def load_authorization_code(self, client, code):
+        await asyncio.sleep(0)
+        return AuthorizationCode(
+            code=code,
+            client_id=CLIENT.client_id,
+            scopes=["unblock:worker"],
+            expires_at=time.time() + 60,
+            code_challenge=CHALLENGE,
+            redirect_uri="https://client.invalid/callback",
+            redirect_uri_provided_explicitly=True,
+            resource=self.bound,
+        )
+
+    async def exchange_authorization_code(self, client, code):
+        await asyncio.sleep(0)
+        self.effects.append("code-issued")
+        return OAuthToken(
+            access_token="synthetic-unused", token_type="Bearer", expires_in=60
+        )
+
+    async def load_refresh_token(self, client, token):
+        return BoundRefresh(
+            token=token,
+            client_id=CLIENT.client_id,
+            scopes=["unblock:worker"],
+            expires_at=int(time.time()) + 60,
+            resource=self.bound,
+        )
+
+    async def exchange_refresh_token(self, client, token, scopes):
+        await asyncio.sleep(0)
+        self.effects.append("refresh-issued")
+        return OAuthToken(
+            access_token="synthetic-unused", token_type="Bearer", expires_in=60
+        )
+
+
+def form(grant, resources):
+    items = [("grant_type", grant), ("client_id", CLIENT.client_id)]
+    if grant == "authorization_code":
+        items += [
+            ("code", "synthetic-code"),
+            ("redirect_uri", "https://client.invalid/callback"),
+            ("code_verifier", VERIFIER),
+        ]
+    else:
+        items.append(("refresh_token", "synthetic-refresh"))
+    return items + [("resource", resource) for resource in resources]
+
+
+async def issue(provider, grant, resources, *, handler=None, overrides=None):
+    items = form(grant, resources)
+    if overrides:
+        items = [(key, overrides.get(key, value)) for key, value in items]
+    body = urlencode(items).encode()
+
+    async def receive():
+        return {"type": "http.request", "body": body, "more_body": False}
+
+    request = Request(
+        {
+            "type": "http",
+            "method": "POST",
+            "path": "/token",
+            "headers": [(b"content-type", b"application/x-www-form-urlencoded")],
+            "query_string": b"",
+        },
+        receive,
+    )
+    return await (handler or ResourceTokenHandler(provider, Authenticator())).handle(
+        request
+    )
+
+
+@pytest.mark.parametrize(
+    "grant,resources,want",
+    [
+        ("authorization_code", [RESOURCE], 200),
+        ("authorization_code", [OTHER], 400),
+        ("authorization_code", [], 400),
+        ("authorization_code", [""], 400),
+        ("authorization_code", [RESOURCE, RESOURCE], 400),
+        ("authorization_code", [OTHER, RESOURCE], 400),
+        ("refresh_token", [RESOURCE], 200),
+        ("refresh_token", [], 200),
+        ("refresh_token", [OTHER], 400),
+        ("refresh_token", [""], 400),
+        ("refresh_token", [RESOURCE, RESOURCE], 400),
+        ("refresh_token", [OTHER, RESOURCE], 400),
+    ],
+)
+async def test_resource_checked_before_issuance(grant, resources, want):
+    provider = Provider()
+    response = await issue(provider, grant, resources)
+    assert response.status_code == want
+    if want == 400:
+        assert provider.effects == []
+        assert json.loads(response.body)["error"] in [
+            "invalid_request",
+            "invalid_grant",
+        ]
+    else:
+        assert len(provider.effects) == 1
+
+
+@pytest.mark.parametrize("grant", ["authorization_code", "refresh_token"])
+async def test_missing_stored_binding_denies_before_issuance(grant):
+    provider = Provider(bound=None)
+    response = await issue(provider, grant, [RESOURCE])
+    assert response.status_code == 400
+    assert provider.effects == []
+
+
+async def test_concurrent_requests_do_not_share_requested_resource():
+    provider = Provider()
+    handler = ResourceTokenHandler(provider, Authenticator())
+    good, bad = await asyncio.gather(
+        issue(provider, "authorization_code", [RESOURCE], handler=handler),
+        issue(provider, "authorization_code", [OTHER], handler=handler),
+    )
+    assert (good.status_code, bad.status_code) == (200, 400)
+    assert provider.effects == ["code-issued"]
+
+
+@pytest.mark.parametrize(
+    "overrides",
+    [
+        {"redirect_uri": "https://other.invalid/callback"},
+        {"code_verifier": "wrong-verifier"},
+    ],
+)
+async def test_resource_guard_preserves_sdk_redirect_and_pkce_validation(overrides):
+    provider = Provider()
+    response = await issue(
+        provider, "authorization_code", [RESOURCE], overrides=overrides
+    )
+    assert response.status_code == 400
+    assert provider.effects == []
