+    async def _consent(self, consent_id, secret):
+        if (
+            not isinstance(consent_id, str)
+            or not re.fullmatch(r"[a-f0-9]{64}", consent_id)
+            or not isinstance(secret, str)
+            or len(secret) > 200
+        ):
+            raise BridgeRejected("invalid consent proof")
+        key = state_key("consent", consent_id)
+        row, _ = await self._required(key)
+        expected = row["binding"].get("csrf_sha256")
+        if (
+            not isinstance(expected, str)
+            or not hmac.compare_digest(
+                hashlib.sha256(secret.encode()).hexdigest(), expected
+            )
+            or row["status"] != "pending"
+            or row["expires_at"] <= self.now()
+        ):
+            raise BridgeRejected("consent is unavailable, expired or already processed")
+        return key, row
+
+    async def consent_snapshot(self, consent_id, secret):
+        _, row = await self._consent(consent_id, secret)
+        binding = row["binding"]
+        project = binding["project"]
+        return {
+            "client_id": binding["client_id"],
+            "client_name": binding["client_name"],
+            "redirect_uri": binding["redirect_uri"],
+            "resource": binding["resource"],
+            "subject": project["subject"],
+            "project_id": project["project_id"],
+            "expires_at": row["expires_at"],
+            "session_expires_at": binding["session_expires_at"],
+        }
+
+    async def approve_consent(self, consent_id, secret, *, agent, environment, name):
+        key, row = await self._consent(consent_id, secret)
+        binding = row["binding"]
+        owner = await self.vault.load(binding["owner_key"], allow_refresh=False)
+        project = await self.bridge.resolve_owned_project(
+            owner,
+            binding["project"]["project_id"],
+            binding["resource"],
+            agent,
+            environment,
+            name,
+        )
+        if project.subject != binding["project"]["subject"]:
+            raise BridgeRejected("consent owner changed")
