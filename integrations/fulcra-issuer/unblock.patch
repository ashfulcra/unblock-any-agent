+++ b/fulcra_mcp/unblock_consent.py
@@ -0,0 +1,354 @@
+"""Optional resource issuer HTTP routes and explicit human worker consent."""
+
+import hmac
+from html import escape
+
+import structlog
+from mcp.server.auth.handlers.authorize import AuthorizationHandler
+from mcp.server.auth.handlers.metadata import MetadataHandler
+from mcp.server.auth.handlers.revoke import RevocationHandler
+from mcp.server.auth.middleware.client_auth import ClientAuthenticator
+from mcp.server.auth.provider import TokenError
+from mcp.server.auth.routes import build_metadata, create_auth_routes, cors_middleware
+from mcp.server.auth.settings import ClientRegistrationOptions, RevocationOptions
+from pydantic import AnyHttpUrl
+from starlette.applications import Starlette
+from starlette.datastructures import FormData
+from starlette.middleware import Middleware
+from starlette.responses import HTMLResponse, JSONResponse, RedirectResponse
+from starlette.routing import Mount, Route
+
+from .settings import settings
+from .unblock_bridge import NativeBridge, BridgeRejected, BridgeUnavailable
+from .unblock_owner import OwnerVault
+from .unblock_provider import UnblockProvider, WORKER_SCOPE
+from .unblock_resource import ResourceTokenHandler, parse_resource
+from .unblock_state import configured_store
+
+logger = structlog.getLogger(__name__)
+HEADERS = {
+    "Cache-Control": "no-store",
+    "Pragma": "no-cache",
+    "Referrer-Policy": "no-referrer",
+    "X-Content-Type-Options": "nosniff",
+    "Content-Security-Policy": "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'",
+}
+
+
+def cookie_name(consent_id):
+    return "__Host-unblock-" + consent_id
+
+
+def _error(
+    status,
+    text="Connection could not be authorized. Return to your client and reconnect. Pending work is preserved.",
+):
+    return HTMLResponse(
+        '<!doctype html><html lang="en"><meta charset="utf-8"><title>Unblock connection</title><main><h1>Unblock connection</h1><p>'
+        + escape(text)
+        + "</p></main></html>",
+        status_code=status,
+        headers=HEADERS,
+    )
+
+
+async def callback_response(request, provider):
+    items = list(request.query_params.multi_items())
+    if any(sum(key == name for key, _ in items) != 1 for name in ("code", "state")):
+        return _error(400)
+    try:
+        consent_id, secret = await provider.receive_callback(
+            request.query_params["code"], request.query_params["state"]
+        )
+        response = RedirectResponse(
+            provider.origin + "/unblock/consent/" + consent_id,
+            status_code=302,
+            headers=HEADERS,
+        )
+        response.set_cookie(
+            cookie_name(consent_id),
+            secret,
+            max_age=600,
+            secure=True,
+            httponly=True,
+            samesite="lax",
+            path="/",
+        )
+        return response
+    except BridgeRejected:
+        return _error(400)
+    except Exception:
+        return _error(
+            503,
+            "Authorization is unresolved. Start a new connection; prior pending state is retained.",
+        )
+
+
+def consent_html(snapshot, secret):
+    e = lambda value: escape(str(value), quote=True)
+    return (
+        """<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Connect Unblock Any Agent</title>
+<style>body{font:16px/1.55 system-ui,sans-serif;background:#f5f6f8;color:#18212b;margin:0;padding:32px 16px}main{max-width:640px;margin:auto;background:white;border:1px solid #dce1e7;border-radius:16px;padding:28px}h1{font-size:28px;line-height:1.2}dl{background:#f5f6f8;padding:16px;border-radius:8px;overflow-wrap:anywhere}dt{font-weight:650;margin-top:8px}dd{margin:0}label{display:block;font-weight:600;margin:18px 0 5px}input{box-sizing:border-box;width:100%;font:inherit;padding:10px;border:1px solid #8795a5;border-radius:6px}button{font:inherit;padding:11px 18px;border-radius:7px;border:1px solid #39465c;cursor:pointer;background:#263e70;color:white;margin:20px 8px 0 0}button[value=deny]{background:white;color:#263e70}.detail{font-size:14px;color:#475566}</style></head><body><main>
+<h1>Connect Unblock Any Agent</h1><p>Approve a worker on your dashboard for this client.</p><dl>
+<dt>Requesting client</dt><dd>"""
+        + e(snapshot["client_name"])
+        + """</dd><dt>Client ID</dt><dd>"""
+        + e(snapshot["client_id"])
+        + """</dd>
+<dt>Client callback</dt><dd>"""
+        + e(snapshot["redirect_uri"])
+        + """</dd><dt>Verified dashboard</dt><dd>"""
+        + e(snapshot["resource"])
+        + """</dd>
+<dt>Signed-in account ID</dt><dd>"""
+        + e(snapshot["subject"])
+        + '''</dd></dl>
+<p>The worker can request your help, recover its context and answers, record progress and expected updates, and retain action evidence. Its runtime performs approved work.</p>
+<p class="detail">Worker tokens last at most one hour. Connection renewal lasts up to 24 hours, subject to your Fulcra sign-in. When reconnecting, use the same agent ID and environment to recover work.</p>
+<form method="post"><input type="hidden" name="csrf" value="'''
+        + e(secret)
+        + """">
+<label for="agent">Agent ID</label><input id="agent" name="agent" required maxlength="100" pattern="[a-z0-9][a-z0-9-]{0,99}" placeholder="research-agent" autocomplete="off">
+<label for="environment">Environment</label><input id="environment" name="environment" required maxlength="100" pattern="[A-Za-z0-9][A-Za-z0-9._-]{0,99}" placeholder="chatgpt-work" autocomplete="off">
+<label for="name">Display name</label><input id="name" name="name" required maxlength="100" placeholder="Research worker" autocomplete="off">
+<button type="submit" name="decision" value="approve">Connect worker</button><button type="submit" name="decision" value="deny" formnovalidate>Decline</button></form></main></body></html>"""
+    )
+
+
+class BodyLimitMiddleware:
+    def __init__(self, app):
+        self.app = app
+
+    async def __call__(self, scope, receive, send):
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        if len(scope.get("query_string", b"")) > 8192:
+            await JSONResponse(
+                {"error": "invalid_request"}, status_code=414, headers=HEADERS
+            )(scope, receive, send)
+            return
+        if scope["method"] != "POST":
+            await self.app(scope, receive, send)
+            return
+        chunks = []
+        size = 0
+        while True:
+            message = await receive()
+            if message["type"] != "http.request":
+                await JSONResponse(
+                    {"error": "invalid_request"}, status_code=400, headers=HEADERS
+                )(scope, receive, send)
+                return
+            chunk = message.get("body", b"")
+            size += len(chunk)
+            if size > 65536:
+                await JSONResponse(
+                    {"error": "invalid_request"}, status_code=413, headers=HEADERS
+                )(scope, receive, send)
+                return
+            chunks.append(chunk)
+            if not message.get("more_body", False):
+                break
+        body = b"".join(chunks)
+        delivered = False
+
+        async def replay():
+            nonlocal delivered
+            if not delivered:
+                delivered = True
+                return {"type": "http.request", "body": body, "more_body": False}
+            return await receive()
+
+        await self.app(scope, replay, send)
+
+
+class _OptionalRevocationSecret:
+    """Normalize the pinned SDK's required nullable form field.
+
+    The SDK still authenticates the registered client and checks token ownership.
+    An empty default supplies no authority for confidential clients.
+    """
+
+    def __init__(self, request):
+        self.request = request
+
+    def __getattr__(self, name):
+        return getattr(self.request, name)
+
+    async def form(self):
+        form = await self.request.form()
+        if "client_secret" in form:
+            return form
+        return FormData([*form.multi_items(), ("client_secret", "")])
+
+
+def create_unblock_routes(provider):
+    registration = ClientRegistrationOptions(
+        enabled=True, valid_scopes=[WORKER_SCOPE], default_scopes=[WORKER_SCOPE]
+    )
+    revocation = RevocationOptions(enabled=True)
+    issuer = AnyHttpUrl(provider.origin + "/unblock")
+    routes = create_auth_routes(
+        provider,
+        issuer,
+        client_registration_options=registration,
+        revocation_options=revocation,
+    )
+
+    async def authorize(request):
+        items = (
+            list(request.query_params.multi_items())
+            if request.method == "GET"
+            else list((await request.form()).multi_items())
+        )
+        try:
+            parse_resource(items)
+        except TokenError:
+            return JSONResponse(
+                {"error": "invalid_request"}, status_code=400, headers=HEADERS
+            )
+        return await AuthorizationHandler(provider).handle(request)
+
+    handler = ResourceTokenHandler(provider, ClientAuthenticator(provider))
+    revoker = RevocationHandler(provider, ClientAuthenticator(provider))
+
+    async def revoke(request):
+        return await revoker.handle(_OptionalRevocationSecret(request))
+
+    routes = [
+        Route("/authorize", authorize, methods=["GET", "POST"])
+        if route.path == "/authorize"
+        else Route(
+            "/token",
+            cors_middleware(handler.handle, ["POST", "OPTIONS"]),
+            methods=["POST", "OPTIONS"],
+        )
+        if route.path == "/token"
+        else Route(
+            "/revoke",
+            cors_middleware(revoke, ["POST", "OPTIONS"]),
+            methods=["POST", "OPTIONS"],
+        )
+        if route.path == "/revoke"
+        else route
+        for route in routes
+    ]
+
+    async def consent(request):
+        consent_id = request.path_params["consent_id"]
+        secret = request.cookies.get(cookie_name(consent_id), "")
+        try:
+            if request.method == "GET":
+                snapshot = await provider.consent_snapshot(consent_id, secret)
+                return HTMLResponse(consent_html(snapshot, secret), headers=HEADERS)
+            if request.headers.get("origin") != provider.origin:
+                return _error(403)
+            if not request.headers.get("content-type", "").startswith(
+                "application/x-www-form-urlencoded"
+            ):
+                return _error(415)
+            form = await request.form()
+            items = list(form.multi_items())
+            allowed = {"csrf", "decision", "agent", "environment", "name"}
+            if any(key not in allowed for key, _ in items) or any(
+                sum(key == name for key, _ in items) > 1 for name in allowed
+            ):
+                return _error(400)
+            csrf = form.get("csrf")
+            if (
+                not isinstance(csrf, str)
+                or not secret
+                or not hmac.compare_digest(csrf, secret)
+            ):
+                return _error(403)
+            if form.get("decision") == "approve":
+                target = await provider.approve_consent(
+                    consent_id,
+                    secret,
+                    agent=form.get("agent"),
+                    environment=form.get("environment"),
+                    name=form.get("name"),
+                )
+            elif form.get("decision") == "deny":
+                target = await provider.decline_consent(consent_id, secret)
+            else:
+                return _error(400)
+            response = RedirectResponse(target, status_code=302, headers=HEADERS)
+            response.delete_cookie(
+                cookie_name(consent_id),
+                path="/",
+                secure=True,
+                httponly=True,
+                samesite="lax",
+            )
+            return response
+        except BridgeRejected:
+            return _error(400)
+        except Exception:
+            return _error(
+                503,
+                "Authorization is unresolved. Pending state is retained; return to the client and reconnect.",
+            )
+
+    routes.append(Route("/consent/{consent_id}", consent, methods=["GET", "POST"]))
+
+    async def unavailable(request, exc):
+        return JSONResponse(
+            {
+                "error": "server_error",
+                "error_description": "Authorization source unavailable; pending state retained",
+            },
+            status_code=503,
+            headers=HEADERS,
+        )
+
+    async def rejected(request, exc):
+        return JSONResponse(
+            {"error": "invalid_grant"}, status_code=400, headers=HEADERS
+        )
+
+    subapp = Starlette(
+        routes=routes,
+        middleware=[Middleware(BodyLimitMiddleware)],
+        exception_handlers={BridgeUnavailable: unavailable, BridgeRejected: rejected},
+    )
+    metadata = build_metadata(issuer, None, registration, revocation)
+    discovery = Route(
+        "/.well-known/oauth-authorization-server/unblock",
+        cors_middleware(MetadataHandler(metadata).handle, ["GET", "OPTIONS"]),
+        methods=["GET", "OPTIONS"],
+    )
+    return [discovery, Mount("/unblock", app=subapp)]
+
+
+def optional_provider():
+    if not settings.unblock_enabled:
+        return None
+    if not settings.unblock_allow_owned_resources and not settings.unblock_resources:
+        logger.warning("unblock_issuer_disabled_missing_resource_policy")
+        return None
+    if not all(
+        [
+            settings.state_bucket,
+            settings.oidc_client_id,
+            settings.fulcra_oidc_domain,
+            settings.fulcra_api,
+        ]
+    ):
+        logger.warning("unblock_issuer_disabled_missing_existing_service_configuration")
+        return None
+    try:
+        store = configured_store()
+        return UnblockProvider(
+            store,
+            NativeBridge(settings.fulcra_api),
+            OwnerVault(store),
+            issuer_origin=settings.oidc_server_url,
+            allowed_resources=None
+            if settings.unblock_allow_owned_resources
+            else settings.unblock_resources,
+        )
+    except Exception:
+        logger.warning("unblock_issuer_disabled_configuration_unavailable")
+        return None
