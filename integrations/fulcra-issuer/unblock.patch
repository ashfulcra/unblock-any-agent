+            access = OwnerAccess(
+                credentials.access_token,
+                int(credentials.access_token_expiration.timestamp()),
+            )
+            project = await self.bridge.find_project(access, row["binding"]["resource"])
+            session_expiry = int(self.now()) + OWNER_SESSION_SECONDS
+            if credentials.refresh_token_expiration is not None:
+                session_expiry = min(
+                    session_expiry,
+                    int(credentials.refresh_token_expiration.timestamp()),
