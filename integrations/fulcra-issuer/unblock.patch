diff --git a/fulcra_mcp/unblock_bridge.py b/fulcra_mcp/unblock_bridge.py
new file mode 100644
index 0000000..d509521
--- /dev/null
+++ b/fulcra_mcp/unblock_bridge.py
@@ -0,0 +1,398 @@
+"""Verified owner/deployment bridge to the existing native worker service."""
+
+from dataclasses import dataclass, field
+import re
+import time
+from urllib.parse import urlsplit
+from uuid import UUID
+
+import httpx
+
+
+class BridgeRejected(Exception):
+    """A proven authorization/binding failure; reconnect or correct consent."""
+
+
+class BridgeUnavailable(Exception):
+    """The source/effect is unknown. Retain the original frozen intent."""
+
+
+@dataclass(frozen=True)
+class OwnerAccess:
+    token: str = field(repr=False)
+    expires_at: int
+
+
+@dataclass(frozen=True)
+class ProjectBinding:
+    subject: str
+    project_id: str
+    origin: str
+    resource: str
+    agent: str
+    environment: str
+    name: str
+
+
+@dataclass(frozen=True)
+class NativeGrantReceipt:
+    grant_id: str
+    record_id: str
+    credential: str = field(repr=False)
+    expires_at: int
+
+
+def _uuid(value):
+    try:
+        return str(UUID(value))
+    except (ValueError, TypeError, AttributeError):
+        raise BridgeRejected("invalid project or grant reference") from None
+
+
+def _origin(domain):
+    if not isinstance(domain, str) or not re.fullmatch(
+        r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.my\.fulcra\.ai",
+        domain,
+    ):
+        raise BridgeRejected("unsupported canonical deployment domain")
+    return "https://" + domain
+
+
+def validate_saved_project(binding):
+    """Pure structure check; ownership/liveness still require live revalidation."""
+    if (
+        not isinstance(binding.subject, str) or not 0 < len(binding.subject) <= 200
+        or _uuid(binding.project_id) != binding.project_id
+        or binding.origin != _origin(urlsplit(binding.resource).hostname or "")
+        or binding.resource != binding.origin + "/mcp"
+        or not isinstance(binding.agent, str)
+        or re.fullmatch(r"[a-z0-9][a-z0-9-]{0,99}", binding.agent) is None
+        or not isinstance(binding.environment, str)
+        or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,99}", binding.environment) is None
+        or not isinstance(binding.name, str) or not binding.name.strip()
+        or len(binding.name) > 100
+    ):
+        raise BridgeRejected("invalid saved worker binding")
+
+
+def validate_saved_intent(binding, intent):
+    """Use the exact native intent schema without requiring its lease to be live."""
+    validate_saved_project(binding)
+    if (
+        not isinstance(intent, dict)
+        or set(intent) != {
+            "intent_id", "agent_id", "name", "kind", "environment", "expires_at", "renewal_of"
+        }
+        or intent["agent_id"] != binding.agent
+        or intent["name"] != binding.name
+        or intent["kind"] != "agent"
+        or intent["environment"] != binding.environment
+        or not isinstance(intent["intent_id"], str)
+        or not intent["intent_id"].strip() or len(intent["intent_id"]) > 160
+        or type(intent["expires_at"]) is not int or intent["expires_at"] <= 0
+    ):
+        raise BridgeRejected("invalid saved enrollment intent")
+    if intent["renewal_of"] is not None and _uuid(intent["renewal_of"]) != intent["renewal_of"]:
+        raise BridgeRejected("renewal reference changed")
+
+
+class NativeBridge:
+    def __init__(self, api_origin: str, *, transport=None, now=time.time):
+        parts = urlsplit(api_origin)
+        if (
+            parts.scheme != "https"
+            or not parts.hostname
+            or parts.username
+            or parts.password
+            or parts.query
+            or parts.fragment
+            or parts.path not in ("", "/")
+            or parts.port not in (None, 443)
+        ):
+            raise ValueError("a trusted HTTPS platform API origin is required")
+        self.api_origin = api_origin.rstrip("/")
+        self.transport, self.now = transport, now
+
+    def _owner(self, owner: OwnerAccess):
+        if (
+            not isinstance(owner.token, str)
+            or len(owner.token) > 20000
+            or not re.fullmatch(r"[A-Za-z0-9._~-]+", owner.token)
+            or type(owner.expires_at) is not int
+            or owner.expires_at <= self.now()
+        ):
+            raise BridgeRejected("owner authentication expired or invalid")
+
+    async def _request(self, method, url, *, headers, body=None, list_result=False):
+        try:
+            async with httpx.AsyncClient(
+                timeout=15, follow_redirects=False, transport=self.transport
+            ) as client:
+                response = await client.request(
+                    method, url, headers=headers, json=body, follow_redirects=False
+                )
+            # No redirects, including a redirect returned by an owned app.
+            if 300 <= response.status_code < 400:
+                raise BridgeRejected("source redirect is not permitted")
+            try:
+                result = response.json()
+            except (ValueError, UnicodeError):
+                result = None
+            if isinstance(result, dict) and result.get("outcome") == "uncertain":
+                raise BridgeUnavailable("source publication remains uncertain")
+            if response.status_code in (400, 401, 403, 404):
+                raise BridgeRejected("source rejected the approved binding")
+            if response.status_code not in (200, 202) or not isinstance(
+                result, list if list_result else dict
+            ):
+                raise BridgeUnavailable("source response unavailable")
+            return result
+        except (BridgeRejected, BridgeUnavailable):
+            raise
+        except Exception:
+            raise BridgeUnavailable("source request outcome unavailable") from None
+
+    async def _platform(self, owner, path, *, list_result=False):
+        self._owner(owner)
+        return await self._request(
+            "GET",
+            self.api_origin + path,
+            headers={"Authorization": "Bearer " + owner.token},
+            list_result=list_result,
+        )
+
+    async def resolve_owned_project(
+        self, owner, project_id, resource, agent, environment, name
+    ):
+        project_id = _uuid(project_id)
+        if (
+            not isinstance(agent, str)
+            or not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,99}", agent)
+            or not isinstance(environment, str)
+            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,99}", environment)
+            or not isinstance(name, str)
+            or not name.strip()
+            or len(name) > 100
+        ):
+            raise BridgeRejected("invalid approved worker or environment")
+        user = await self._platform(owner, "/user/v1alpha1/info")
+        subject = user.get("userid")
+        if not isinstance(subject, str) or not subject or len(subject) > 200:
+            raise BridgeUnavailable("verified owner identity unavailable")
+        project = await self._platform(owner, "/user/v1/deploy/project/" + project_id)
+        if project.get("id") != project_id:
+            raise BridgeRejected("owned project does not match")
+        origin = _origin(project.get("domain"))
+        if resource != origin + "/mcp":
+            raise BridgeRejected("resource does not match canonical owned deployment")
+        return ProjectBinding(
+            subject, project_id, origin, resource, agent, environment, name
+        )
+
+    async def find_project(self, owner, resource):
+        projects = await self._platform(
+            owner, "/user/v1/deploy/project", list_result=True
+        )
+        matches = []
+        for project in projects:
+            try:
+                origin = _origin(project.get("domain"))
+            except (BridgeRejected, AttributeError):
+                continue
+            if resource == origin + "/mcp":
+                matches.append(project)
+        if len(matches) != 1:
+            raise BridgeRejected("resource needs one verified owned deployment")
+        return await self.resolve_owned_project(
+            owner,
+            matches[0].get("id"),
+            resource,
+            "pending-consent",
+            "pending-consent",
+            "Pending consent",
+        )
+
+    async def _revalidate(self, binding, owner):
+        current = await self.resolve_owned_project(
+            owner,
+            binding.project_id,
+            binding.resource,
+            binding.agent,
+            binding.environment,
+            binding.name,
+        )
+        if current != binding:
+            raise BridgeRejected("approved owner or deployment changed")
+        return current
+
+    async def _native(self, binding, owner, operation, body=None):
+        headers = {
+            "Cookie": "fulcra_access_token=" + owner.token,
+            "Origin": binding.origin,
+        }
+        return await self._request(
+            "POST" if body is not None else "GET",
+            binding.origin + "/api/unblock/" + operation,
+            headers=headers,
+            body=body,
+        )
+
+    async def prepare_enrollment(self, binding, owner, intent_id, *, renewal_of=None):
+        await self._revalidate(binding, owner)
+        if (
+            not isinstance(intent_id, str)
+            or not intent_id.strip()
+            or len(intent_id) > 160
+        ):
+            raise BridgeRejected("stable enrollment intent required")
+        if renewal_of is not None:
+            renewal_of = _uuid(renewal_of)
+        prepared = await self._native(binding, owner, "prepare_enrollment")
+        expiry = prepared.get("expires_at")
+        if type(expiry) is not int or expiry <= self.now():
+            raise BridgeUnavailable("prepared native expiry unavailable")
+        return {
+            "intent_id": intent_id,
+            "agent_id": binding.agent,
+            "name": binding.name,
+            "kind": "agent",
+            "environment": binding.environment,
+            "expires_at": min(expiry, owner.expires_at, int(self.now()) + 3600),
+            "renewal_of": renewal_of,
+        }
+
+    def _intent(self, binding, owner, intent):
+        validate_saved_intent(binding, intent)
+        if not self.now() < intent["expires_at"] <= min(owner.expires_at, int(self.now()) + 3600):
+            raise BridgeRejected("enrollment intent changed or expired")
+
+    async def _receipt(self, binding, response, intent):
+        try:
+            grant_id, record_id = (
+                _uuid(response.get("grant_id")),
+                _uuid(response.get("record_id")),
+            )
+            credential = response.get("credential")
+            if (
+                response.get("agent_id") != binding.agent
+                or response.get("kind") != "agent"
+                or response.get("environment") != binding.environment
+                or response.get("agent_ids") != [binding.agent]
+                or response.get("expires_at") != intent["expires_at"]
+                or not isinstance(credential, str)
+                or not credential
+                or len(credential) > 20000
+            ):
+                raise BridgeUnavailable("native grant receipt does not match")
+            checked = await self._request(
+                "GET",
+                binding.origin + "/api/unblock/enrollment",
+                headers={"Authorization": "Bearer " + credential},
+            )
+            if checked != {
+                "kind": "agent",
+                "id": binding.agent,
+                "environment": binding.environment,
+                "grant_id": grant_id,
+                "expires_at": intent["expires_at"],
+                "agent_ids": [binding.agent],
+            }:
+                raise BridgeUnavailable("native enrollment readback does not match")
+            return NativeGrantReceipt(
+                grant_id, record_id, credential, intent["expires_at"]
+            )
+        except BridgeRejected:
+            # The POST may already have succeeded; denied/malformed readback
+            # cannot justify another initial enrollment or an issued OAuth token.
+            raise BridgeUnavailable(
+                "native grant readback remains unresolved"
+            ) from None
+
+    async def enroll_worker(self, binding, owner, frozen_intent):
+        await self._revalidate(binding, owner)
+        self._intent(binding, owner, frozen_intent)
+        response = await self._native(binding, owner, "enroll", frozen_intent)
+        return await self._receipt(binding, response, frozen_intent)
+
+    async def reconcile_enrollment(self, binding, owner, frozen_intent):
+        await self._revalidate(binding, owner)
+        self._intent(binding, owner, frozen_intent)
+        attention = await self._native(binding, owner, "attention")
+        if attention.get("source") != "checked" or not isinstance(
+            attention.get("grants"), list
+        ):
+            raise BridgeUnavailable("native enrollment source unavailable")
+        matches = [
+            row
+            for row in attention["grants"]
+            if row.get("intent_id") == frozen_intent["intent_id"]
+        ]
+        if not matches:
+            return None
+        if len(matches) != 1:
+            raise BridgeRejected("conflicting enrollment receipts")
+        row = matches[0]
+        if (
+            any(row.get(key) != value for key, value in frozen_intent.items())
+            or row.get("agent_ids") != [binding.agent]
+            or row.get("revoked") is not False
+        ):
+            raise BridgeRejected("retained enrollment scope changed or was revoked")
+        # Only after the exact source record exists can the idempotent native
+        # enroll operation return another sealed representation of that grant.
+        response = await self._native(binding, owner, "enroll", frozen_intent)
+        receipt = await self._receipt(binding, response, frozen_intent)
+        if receipt.record_id != row.get("record_id") or receipt.grant_id != row.get(
+            "grant_id"
+        ):
+            raise BridgeUnavailable("recovered enrollment receipt changed")
+        return receipt
+
+    async def _owned_grant(self, binding, owner, grant_id):
+        grant_id = _uuid(grant_id)
+        await self._revalidate(binding, owner)
+        attention = await self._native(binding, owner, "attention")
+        if attention.get("source") != "checked" or not isinstance(
+            attention.get("grants"), list
+        ):
+            raise BridgeUnavailable("native grant source unavailable")
+        rows = [row for row in attention["grants"] if row.get("grant_id") == grant_id]
+        if len(rows) != 1:
+            raise BridgeUnavailable("native grant receipt unavailable or conflicting")
+        row = rows[0]
+        if (
+            row.get("agent_id") != binding.agent
+            or row.get("environment") != binding.environment
+            or row.get("name") != binding.name
+            or row.get("kind") != "agent"
+            or row.get("agent_ids") != [binding.agent]
+        ):
+            raise BridgeRejected("native grant is outside the approved worker scope")
+        if type(row.get("revoked")) is not bool:
+            raise BridgeUnavailable("native revocation source unavailable")
+        return row
+
+    async def revocation_observed(self, binding, owner, grant_id):
+        return (await self._owned_grant(binding, owner, grant_id))["revoked"]
+
+    async def revoke_worker(self, binding, owner, grant_id, intent_id):
+        row = await self._owned_grant(binding, owner, grant_id)
+        if row["revoked"]:
+            return True
+        if (
+            not isinstance(intent_id, str)
+            or not intent_id.strip()
+            or len(intent_id) > 160
+        ):
+            raise BridgeRejected("stable revocation intent required")
+        # The caller durably freezes this intent before calling. After an
+        # uncertain response it uses revocation_observed, never a blind resend.
+        await self._native(
+            binding,
+            owner,
+            "revoke",
+            {"intent_id": intent_id, "grant_id": row["grant_id"]},
+        )
+        if not await self.revocation_observed(binding, owner, row["grant_id"]):
+            raise BridgeUnavailable("native revocation is pending source readback")
+        return True
