+    async def exchange_authorization_code(self, client, authorization_code):
+        key = state_key("code", authorization_code.code)
+        row, _ = await self._required(key)
+        if (
+            row["binding"]["client_id"] != client.client_id
+            or row["binding"]["resource"] != authorization_code.resource
+        ):
+            raise TokenError("invalid_grant", "authorization binding does not match")
+        if row["status"] != "pending":
+            await self._request_revocation(key)
+            raise TokenError("invalid_grant", "authorization code already consumed")
+        claim = secrets.token_hex(16)
+        try:
+            await asyncio.to_thread(self.transactions.claim, key, claim)
+        except StateConflict:
+            await self._request_revocation(key)
+            raise TokenError(
+                "invalid_grant", "authorization code already consumed"
+            ) from None
+        except Exception:
+            raise TokenError(
+                "invalid_grant", "authorization code claim unavailable"
+            ) from None
+        binding = row["binding"]
+        phase = "owner_access"
+        try:
+            await self._active(key, initial=True)
+            owner = await self.vault.load(binding["owner_key"])
+            project = ProjectBinding(**binding["project"])
+            intent = await self.bridge.prepare_enrollment(
+                project, owner, "uaa-enroll-" + secrets.token_hex(32)
+            )
+            await self._checkpoint(key, claim, "native_intent", intent)
+            await self._active(key, initial=True)
+            phase = "native_enrollment"
+            receipt = await self.bridge.enroll_worker(project, owner, intent)
+            await self._checkpoint(key, claim, "native_receipt", asdict(receipt))
+            phase = "token_publication"
+            return await self._materialize(key, claim, binding, receipt, initial=True)
+        except Exception:
+            await self._uncertain(key, claim, phase)
+            raise TokenError(
+                "invalid_grant",
+                "connection outcome is pending recovery; reconnect if requested",
+            ) from None
