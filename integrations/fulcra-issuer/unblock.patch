+    async def _active(self, root, *, initial=False):
+        row, _ = await self._required(root)
+        if row.get("revocation_requested"):
+            await self.recover_pending_code(root)
+            raise TokenError("invalid_grant", "connection revocation is requested")
+        if row["status"] != "completed" and not (
+            initial and row["status"] == "claimed"
+        ):
+            raise TokenError("invalid_grant", "connection is not active")
+
+    def _replacement(self, row):
+        checkpoints = row["checkpoints"]
+        receipt, refresh = checkpoints["native_receipt"], checkpoints["refresh_token"]
+        return OAuthToken(
+            access_token=receipt["credential"],
+            token_type="Bearer",
+            expires_in=max(0, receipt["expires_at"] - int(self.now())),
+            scope=WORKER_SCOPE,
+            refresh_token=refresh["token"],
+        )
+
+    async def _materialize(self, key, claim, binding, receipt, *, initial):
+        root = binding["root_code_key"]
+        await self._active(root, initial=initial)
+        row, _ = await self._required(key)
+        token_intent = row["checkpoints"].get("refresh_token")
+        if token_intent is None:
+            raw = "uaa-refresh-" + secrets.token_hex(32)
+            token_intent = {
+                "token": raw,
+                "key": state_key("refresh", raw),
+                "expires_at": binding["session_expires_at"],
+            }
+            await self._checkpoint(key, claim, "refresh_token", token_intent)
+        timing = row["checkpoints"].get("response_timing") or {
+            "issued_at": int(self.now())
+        }
+        await self._checkpoint(key, claim, "response_timing", timing)
+        refresh_binding = {
+            k: binding[k]
+            for k in (
+                "client_id",
+                "scopes",
+                "resource",
+                "owner_key",
+                "session_expires_at",
+                "project",
+                "root_code_key",
+            )
+        }
+        refresh_binding["current_grant_id"] = receipt.grant_id
+        await self._begin(
+            token_intent["key"], refresh_binding, token_intent["expires_at"]
+        )
+        metadata = {
+            "client_id": binding["client_id"],
+            "resource": binding["resource"],
+            "subject": binding["project"]["subject"],
+            "scopes": binding["scopes"],
+            "root_code_key": root,
+            "grant_id": receipt.grant_id,
+            "expires_at": receipt.expires_at,
+        }
+        access_key = state_key("access", receipt.credential)
+        await self._create(access_key, metadata)
+        await self._active(root, initial=initial)
+        result = {
+            "access_key": access_key,
+            "refresh_key": token_intent["key"],
+            "expires_at": receipt.expires_at,
+            "rotated_at": timing["issued_at"],
+        }
+        completed, _ = await self._finish(key, claim, "completed", result)
+        await self._active(root)
+        return self._replacement(completed)
