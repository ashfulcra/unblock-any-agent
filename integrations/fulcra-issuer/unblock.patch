+def test_effect_checkpoint_is_frozen_before_use_and_retained_through_completion(stores):
+    _, store, replacement = stores
+    tx = Transactions(store, now=lambda: 100)
+    tx.begin(KEY, BINDING, 200)
+    tx.claim(KEY, "claim-a")
+    tx.checkpoint(
+        KEY, "claim-a", "native_intent", {"intent_id": "one", "expires_at": 180}
+    )
+    observed = store.read(KEY)
+    tx.checkpoint(
+        KEY, "claim-a", "native_intent", {"intent_id": "one", "expires_at": 180}
+    )
+    assert store.read(KEY) == observed
+    with pytest.raises(StateConflict):
+        tx.checkpoint(
+            KEY, "claim-a", "native_intent", {"intent_id": "two", "expires_at": 180}
+        )
+    with pytest.raises(StateConflict):
+        tx.checkpoint(KEY, "claim-b", "receipt", {"grant_id": "foreign"})
+    Transactions(replacement, now=lambda: 100).finish(
+        KEY, "claim-a", "completed", {"receipt": "verified"}
+    )
+    assert store.read(KEY)[0]["checkpoints"]["native_intent"] == {
+        "intent_id": "one",
+        "expires_at": 180,
+    }
