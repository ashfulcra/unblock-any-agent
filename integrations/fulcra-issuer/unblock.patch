--- /dev/null
+++ b/tests/test_unblock_operator.py
@@ -0,0 +1,332 @@
+"""Operator observations/recovery use real provider state, not owner token output."""
+
+import json
+from types import SimpleNamespace
+
+import pytest
+from test_unblock_provider import context, approve, login, token, RESOURCE_A, RESOURCE_B
+from fulcra_mcp.unblock_state import state_key
+from fulcra_mcp.unblock_operator import inspect_keys, main
+
+
+async def connected(context):
+    provider = context[4]
+    code, _ = await approve(provider, *await login(provider))
+    await token(provider, code=code)
+    return state_key("code", code)
+
+
+async def request_revoke(context, key):
+    row, generation = context[1].read(key)
+    context[1].replace(key, {**row, "revocation_requested": True}, generation)
+
+
+async def test_read_only_default_never_performs_cleanup(context, monkeypatch):
+    key = await connected(context)
+    await request_revoke(context, key)
+
+    async def forbidden(*args, **kwargs):
+        pytest.fail("read-only inspection attempted a native effect")
+
+    monkeypatch.setattr(context[4], "recover_pending_code", forbidden)
+    report = await inspect_keys(context[4], [key], RESOURCE_A)
+    assert (
+        report["status"] == "pending"
+        and report["items"][0]["action"] == "reconcile_requested_revocation"
+    )
+    assert not context[2].revoked
+
+
+async def test_explicit_recovery_only_reconciles_already_requested_revocation(context):
+    key = await connected(context)
+    before = await inspect_keys(context[4], [key], RESOURCE_A, recover=True)
+    assert before["status"] == "checked" and not context[2].revoked
+    await request_revoke(context, key)
+    report = await inspect_keys(context[4], [key], RESOURCE_A, recover=True)
+    assert (
+        report["status"] == "checked"
+        and report["items"][0]["state"] == "revocation_verified"
+    )
+    assert context[2].revoked
+    assert len(context[2].grants) == 1
+
+
+async def test_other_resource_and_unknown_source_never_report_quiet(context):
+    key = await connected(context)
+    await request_revoke(context, key)
+    report = await inspect_keys(context[4], [key], RESOURCE_B, recover=True)
+    assert (
+        report["status"] == "unresolved"
+        and report["items"][0]["state"] == "scope_mismatch"
+    )
+    assert not context[2].revoked
+    context[1]._bucket.unavailable = True
+    unknown = await inspect_keys(context[4], [key], RESOURCE_A, recover=True)
+    assert (
+        unknown["status"] == "unresolved"
+        and unknown["items"][0]["state"] == "source_unknown"
+    )
+    assert not context[2].revoked
+
+
+async def test_pending_cleanup_is_not_success_and_raw_state_never_escapes(context):
+    key = await connected(context)
+    await request_revoke(context, key)
+    context[2].lose_revocation = True
+    context[2].lose_revocation_readback = True
+    report = await inspect_keys(context[4], [key], RESOURCE_A, recover=True)
+    assert report["status"] == "pending"
+    output = json.dumps(report)
+    for secret in [
+        "synthetic-native",
+        "synthetic-access",
+        "synthetic-owner-refresh",
+        "owner_key",
+        "client_id",
+        "subject",
+    ]:
+        assert secret not in output
+
+
+async def test_provider_recovery_rechecks_expected_resource_before_effect(context):
+    key = await connected(context)
+    await request_revoke(context, key)
+    assert (
+        await context[4].recover_pending_code(key, expected_resource=RESOURCE_B)
+        is False
+    )
+    assert not context[2].revoked
+
+
+@pytest.mark.parametrize("keys", [["owner/" + "a" * 64], ["code/" + "a" * 64] * 2, []])
+async def test_rejects_invalid_operator_input_before_source_read(keys):
+    async def forbidden(*args):
+        pytest.fail("invalid key read source")
+
+    with pytest.raises(ValueError):
+        await inspect_keys(SimpleNamespace(_read=forbidden), keys, RESOURCE_A)
+
+
+def test_cli_private_intent_precedes_provider_creation_and_denies_overwrite(
+    tmp_path, monkeypatch
+):
+    import fulcra_mcp.unblock_operator as module
+
+    path = tmp_path / "operator.json"
+    key = "code/" + "a" * 64
+
+    def factory(resource):
+        prepared = json.loads(path.read_text())
+        assert prepared["status"] == "prepared" and prepared["code_keys"] == [key]
+        assert path.stat().st_mode & 0o777 == 0o600
+        raise OSError("secret must remain private")
+
+    monkeypatch.setattr(module, "operator_provider", factory)
+    args = ["--resource", RESOURCE_A, "--code-key", key, "--report", str(path)]
+    assert main(args) == 1
+    value = json.loads(path.read_text())
+    assert value["status"] == "unresolved" and "secret must" not in json.dumps(value)
+    with pytest.raises(FileExistsError):
+        main(args)
+
+
+@pytest.mark.parametrize(
+    "resource",
+    [
+        "http://a.my.fulcra.ai/mcp",
+        "https://a.my.fulcra.ai:443/mcp",
+        "https://user@a.my.fulcra.ai/mcp",
+        "https://a.my.fulcra.ai/mcp?x=1",
+        "https://other.invalid/mcp",
+    ],
+)
+async def test_noncanonical_resources_fail_before_source(resource):
+    async def forbidden(*args):
+        pytest.fail("invalid resource read source")
+
+    with pytest.raises(Exception):
+        await inspect_keys(
+            SimpleNamespace(_read=forbidden),
+            ["code/" + "a" * 64],
+            resource,
+            recover=True,
+        )
+
+
+async def test_malformed_completed_record_is_unknown_not_checked(context):
+    key = await connected(context)
+    row, generation = context[1].read(key)
+    row.pop("checkpoints")
+    context[1].replace(key, row, generation)
+    report = await inspect_keys(context[4], [key], RESOURCE_A, recover=True)
+    assert report["status"] == "unresolved"
+    assert report["items"][0]["state"] == "source_unknown"
+    assert not context[2].revoked
+
+
+@pytest.mark.parametrize(
+    "field,value",
+    [
+        ("checkpoints", {}),
+        ("result", {}),
+        ("checkpoints.native_receipt", {}),
+        ("checkpoints.native_receipt.credential", ""),
+        ("checkpoints.native_receipt.grant_id", "invalid"),
+        ("checkpoints.native_receipt.record_id", None),
+        ("checkpoints.native_receipt.expires_at", True),
+        ("checkpoints.refresh_token", {}),
+        ("checkpoints.refresh_token.token", "invalid"),
+        ("checkpoints.refresh_token.key", "refresh/" + "0" * 64),
+        ("checkpoints.refresh_token.expires_at", 1),
+        ("checkpoints.response_timing", {}),
+        ("checkpoints.response_timing.issued_at", False),
+        ("checkpoints.native_intent", {}),
+        ("checkpoints.native_intent.expires_at", 1),
+        ("result.access_key", "access/" + "0" * 64),
+        ("result.refresh_key", "refresh/" + "0" * 64),
+        ("result.expires_at", 1),
+        ("result.rotated_at", 1),
+    ],
+)
+@pytest.mark.parametrize("revocation_requested", [False, True])
+async def test_incomplete_publication_stays_unresolved_without_effects(
+    context, field, value, revocation_requested
+):
+    key = await connected(context)
+    row, generation = context[1].read(key)
+    target = row
+    parts = field.split(".")
+    for part in parts[:-1]:
+        target = target[part]
+    target[parts[-1]] = value
+    row["revocation_requested"] = revocation_requested
+    context[1].replace(key, row, generation)
+    report = await inspect_keys(context[4], [key], RESOURCE_A, recover=True)
+    assert report["status"] == "unresolved"
+    assert report["items"][0]["state"] == "source_unknown"
+    assert not context[2].revoked
+    output = json.dumps(report)
+    assert "synthetic-native" not in output and "uaa-refresh-" not in output
+
+
+async def test_expired_complete_publication_is_still_structurally_checked(context):
+    key = await connected(context)
+    context[0][0] += 10000
+    report = await inspect_keys(context[4], [key], RESOURCE_A)
+    assert report["status"] == "checked"
+
+
+async def test_empty_completed_dictionaries_give_cli_nonzero(context, tmp_path, monkeypatch):
+    import asyncio
+    import fulcra_mcp.unblock_operator as module
+
+    key = await connected(context)
+    row, generation = context[1].read(key)
+    row.update(checkpoints={}, result={})
+    context[1].replace(key, row, generation)
+    monkeypatch.setattr(module, "operator_provider", lambda resource: context[4])
+    path = tmp_path / "incomplete.json"
+    assert await asyncio.to_thread(main, [
+        "--resource", RESOURCE_A, "--code-key", key, "--report", str(path)
+    ]) == 1
+    assert json.loads(path.read_text())["status"] == "unresolved"
+    assert not context[2].revoked
+
+
+# Frozen initial-code intent schema and its approved worker binding. These
+# corruptions must never become authority for either a clean check or cleanup.
+INTENT_CORRUPTIONS = (
+    [("truncate_intent", None)]
+    + [("delete_intent", key) for key in [
+        "intent_id", "agent_id", "name", "kind", "environment", "expires_at", "renewal_of"
+    ]]
+    + [("intent." + key, value) for key, value in [
+        ("intent_id", ""), ("intent_id", 7), ("intent_id", "x" * 161),
+        ("agent_id", "other-agent"), ("name", "Different worker"),
+        ("kind", "human"), ("environment", "other-env"),
+        ("renewal_of", "00000000-0000-0000-0000-000000000001"),
+        ("unexpected", "field"),
+    ]]
+    + [("delete_project", key) for key in [
+        "subject", "project_id", "origin", "resource", "agent", "environment", "name"
+    ]]
+    + [("project." + key, value) for key, value in [
+        ("subject", ""), ("project_id", "invalid"),
+        ("origin", "https://foreign.my.fulcra.ai"),
+        ("resource", RESOURCE_B), ("agent", "Invalid Agent"),
+        ("environment", "Invalid Env"), ("name", ""),
+    ]]
+    + [("owner_key", "owner/not-a-hash")]
+)
+
+
+@pytest.mark.parametrize("corruption,value", INTENT_CORRUPTIONS)
+@pytest.mark.parametrize("recover", [False, True])
+@pytest.mark.parametrize("status", ["completed", "uncertain"])
+async def test_saved_intent_and_worker_binding_fail_closed_before_recovery(
+    context, monkeypatch, corruption, value, recover, status
+):
+    key = await connected(context)
+    row, generation = context[1].read(key)
+    intent = row["checkpoints"]["native_intent"]
+    project = row["binding"]["project"]
+    if corruption == "truncate_intent":
+        row["checkpoints"]["native_intent"] = {"expires_at": intent["expires_at"]}
+    elif corruption == "delete_intent":
+        intent.pop(value)
+    elif corruption == "delete_project":
+        project.pop(value)
+    elif corruption.startswith("intent."):
+        intent[corruption.split(".")[1]] = value
+    elif corruption.startswith("project."):
+        field = corruption.split(".")[1]
+        project[field] = value
+        # A mutually agreeing malformed worker identifier remains invalid.
+        if field in ["agent", "environment", "name"]:
+            intent[{"agent": "agent_id"}.get(field, field)] = value
+    else:
+        row["binding"][corruption] = value
+    row.update(status=status, revocation_requested=recover)
+    context[1].replace(key, row, generation)
+
+    async def forbidden(*args, **kwargs):
+        pytest.fail("malformed saved intent reached recovery")
+
+    monkeypatch.setattr(context[4], "recover_pending_code", forbidden)
+    report = await inspect_keys(context[4], [key], RESOURCE_A, recover=recover)
+    assert report["status"] == "unresolved"
+    assert report["items"][0]["state"] == "source_unknown"
+    assert not context[2].revoked
+
+
+async def test_expired_complete_intent_can_reconcile_requested_revocation(context):
+    key = await connected(context)
+    await request_revoke(context, key)
+    context[0][0] += 101
+    report = await inspect_keys(context[4], [key], RESOURCE_A, recover=True)
+    assert report["status"] == "checked"
+    assert report["items"][0]["state"] == "revocation_verified"
+    assert context[2].revoked
+
+
+@pytest.mark.parametrize("recover", [False, True])
+async def test_saved_receipt_without_intent_stays_unresolved(context, recover):
+    key = await connected(context)
+    row, generation = context[1].read(key)
+    row["checkpoints"].pop("native_intent")
+    row.update(status="uncertain", revocation_requested=True)
+    context[1].replace(key, row, generation)
+    report = await inspect_keys(context[4], [key], RESOURCE_A, recover=recover)
+    assert report["status"] == "unresolved" and not context[2].revoked
+
+
+async def test_provider_direct_recovery_denies_truncated_initial_intent(context):
+    key = await connected(context)
+    row, generation = context[1].read(key)
+    row["checkpoints"]["native_intent"] = {
+        "expires_at": row["checkpoints"]["native_intent"]["expires_at"]
+    }
+    row["revocation_requested"] = True
+    context[1].replace(key, row, generation)
+    assert await context[4].recover_pending_code(key, expected_resource=RESOURCE_A) is False
+    assert not context[2].revoked
