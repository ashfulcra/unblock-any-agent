+async def token(
+    provider,
+    *,
+    code=None,
+    refresh=None,
+    resource=RESOURCE_A,
+    verifier=VERIFIER,
+    scope=None,
+):
+    fields = [("client_id", CLIENT.client_id)]
+    if code:
+        fields += [
+            ("grant_type", "authorization_code"),
+            ("code", code),
+            ("code_verifier", verifier),
+            ("redirect_uri", "https://client.invalid/callback"),
+        ]
+    else:
+        fields += [("grant_type", "refresh_token"), ("refresh_token", refresh)]
+    if resource is not None:
+        fields.append(("resource", resource))
+    if scope is not None:
+        fields.append(("scope", scope))
+    body = urlencode(fields).encode()
+
+    async def receive():
+        return {"type": "http.request", "body": body, "more_body": False}
+
+    request = Request(
+        {
+            "type": "http",
+            "method": "POST",
+            "path": "/token",
+            "headers": [(b"content-type", b"application/x-www-form-urlencoded")],
+            "query_string": b"",
+        },
+        receive,
+    )
+
+    class Auth:
+        async def authenticate_request(self, request):
+            return CLIENT
+
+    response = await ResourceTokenHandler(provider, Auth()).handle(request)
+    return response.status_code, json.loads(response.body)
+
