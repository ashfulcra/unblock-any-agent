+async def login(provider, identity="a", *, caller_state="caller-state"):
+    resource = RESOURCE_A if identity == "a" else RESOURCE_B
+    params = AuthorizationParams(
+        state=caller_state,
+        scopes=["unblock:worker"],
+        code_challenge=CHALLENGE,
+        redirect_uri="https://client.invalid/callback",
+        redirect_uri_provided_explicitly=True,
+        resource=resource,
+    )
+    url = await provider.authorize(CLIENT, params)
+    internal = parse_qs(urlsplit(url).query)["state"][0]
+    assert internal != caller_state
+    consent_id, secret = await provider.receive_callback(identity, internal)
+    return consent_id, secret
