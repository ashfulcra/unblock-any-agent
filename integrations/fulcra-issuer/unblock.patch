+    async def observe_code_replay(self, client, code, form_items):
+        row, _ = await self._required(state_key("code", code.code))
+        if row["status"] == "pending":
+            return
+        binding = row["binding"]
+        proof_fields = (
+            "client_id",
+            "code",
+            "code_verifier",
+            "redirect_uri",
+            "resource",
+        )
+        if any(sum(key == name for key, _ in form_items) > 1 for name in proof_fields):
+            return
+        form = dict(form_items)
+        try:
+            resource = parse_resource(form_items)
+            verifier = form["code_verifier"]
+            challenge = (
+                base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest())
+                .decode()
+                .rstrip("=")
+            )
+            supplied_redirect = (
+                str(AnyUrl(form["redirect_uri"]))
+                if form.get("redirect_uri") is not None
+                else None
+            )
+            expected_redirect = (
+                binding["redirect_uri"] if binding["redirect_explicit"] else None
+            )
+            valid = (
+                client.client_id == binding["client_id"] == form.get("client_id")
+                and form.get("code") == code.code
+                and resource == binding["resource"]
+                and supplied_redirect == expected_redirect
+                and hmac.compare_digest(challenge, binding["challenge"])
+            )
+        except Exception:
+            return
+        if valid:
+            await self._request_revocation(binding["root_code_key"])
