+
+
+async def test_public_client_secretless_revocation_ends_issued_connection(context):
+    bridge, provider = context[2], context[4]
+    async with await session(provider) as client:
+        registration, tokens = await connected(client, auth_method="none")
+        assert not registration.get("client_secret")
+        response = await client.post(
+            "/unblock/revoke",
+            data={
+                "client_id": registration["client_id"],
