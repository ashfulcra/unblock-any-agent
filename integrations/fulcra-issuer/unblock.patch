+                "login already processed or expired; reconnect"
+            ) from None
+        except Exception:
+            raise BridgeUnavailable("login claim unavailable") from None
+        try:
+            api = self.upstream_factory()
+            await asyncio.to_thread(
+                api.authorize_with_authorization_code,
+                code=upstream_code,
+                redirect_uri=self.origin + "/callback",
+            )
