+"""Prepared intent and atomic replacement must sync file and directory."""
+
+import os
+import stat
+import pytest
+from fulcra_mcp.unblock_ops_report import write_report
+
+
+def test_create_and_replace_sync_file_then_directory(tmp_path, monkeypatch):
+    calls = []
+    original = os.fsync
+
+    def sync(fd):
+        calls.append("directory" if stat.S_ISDIR(os.fstat(fd).st_mode) else "file")
+        original(fd)
+
+    monkeypatch.setattr(os, "fsync", sync)
+    path = tmp_path / "report.json"
+    write_report(path, {"status": "prepared"}, create=True)
+    write_report(path, {"status": "settled"})
+    assert calls == ["file", "directory", "file", "directory"]
+
+
+@pytest.mark.parametrize("command", ["probe", "operator"])
+def test_directory_sync_failure_prevents_client_or_provider_discovery(
+    tmp_path, monkeypatch, command
+):
+    from fulcra_mcp import unblock_probe, unblock_operator
+
+    original = os.fsync
+
+    def sync(fd):
+        if stat.S_ISDIR(os.fstat(fd).st_mode):
+            raise OSError("directory durability unavailable")
+        original(fd)
+
+    monkeypatch.setattr(os, "fsync", sync)
+
+    def forbidden(*args):
+        pytest.fail("effect factory ran before durable intent")
+
+    path = tmp_path / "report.json"
+    if command == "probe":
+        monkeypatch.setattr(unblock_probe, "bucket_factory", forbidden)
+        run = unblock_probe.main
+        args = ["--bucket", "authorized-test", "--prefix", "unblock-acceptance/pilot"]
+    else:
+        monkeypatch.setattr(unblock_operator, "operator_provider", forbidden)
+        run = unblock_operator.main
+        args = [
+            "--resource",
+            "https://a.my.fulcra.ai/mcp",
+            "--code-key",
+            "code/" + "a" * 64,
+        ]
+    with pytest.raises(OSError):
+        run([*args, "--report", str(path)])
