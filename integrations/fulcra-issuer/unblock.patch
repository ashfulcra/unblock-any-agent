+"""An isolated, optional OAuth issuer branch for one approved native worker.
+
+This module neither mounts routes nor discovers credentials at import. The
+original Fulcra OAuth provider and its token namespace remain independent.
+"""
+
+import asyncio
+import base64
+import hashlib
+import hmac
+import re
+import secrets
+import time
+from dataclasses import asdict
+from urllib.parse import urlsplit
+
+from fulcra_api.core import FulcraAPI
+from mcp.server.auth.provider import (
+    AccessToken,
+    AuthorizationCode,
+    AuthorizeError,
+    RefreshToken,
+    RegistrationError,
+    TokenError,
+    construct_redirect_uri,
+)
+from mcp.shared.auth import OAuthClientInformationFull, OAuthToken
+from pydantic import AnyUrl
+from .unblock_resource import parse_resource
+
+from .settings import settings
+from .unblock_bridge import (
+    OwnerAccess,
+    ProjectBinding,
+    NativeGrantReceipt,
+    BridgeRejected,
+    BridgeUnavailable,
+)
+from .unblock_owner import OWNER_SESSION_SECONDS
+from .unblock_state import Transactions, StateConflict, state_key
+
+WORKER_SCOPE = "unblock:worker"
+LOGIN_SECONDS = 600
+CODE_SECONDS = 120
+REFRESH_RETRY_SECONDS = 120
+
+
+class ResourceRefreshToken(RefreshToken):
+    resource: str
+
+
+def _resource(value):
+    try:
+        parts = urlsplit(value)
+        if (
+            not isinstance(value, str)
+            or len(value) > 2048
+            or parts.scheme != "https"
+            or not re.fullmatch(
+                r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.my\.fulcra\.ai",
+                parts.hostname or "",
+            )
+            or value != "https://" + parts.hostname + "/mcp"
+        ):
+            raise ValueError("not canonical")
+    except (TypeError, ValueError):
+        raise BridgeRejected(
+            "a canonical owned Fulcra dashboard resource is required"
+        ) from None
+    return value
+
+
+def upstream_api():
+    return FulcraAPI(
+        oidc_client_id=settings.oidc_client_id,
+        oidc_domain=settings.fulcra_oidc_domain,
+        oidc_audience=settings.fulcra_api,
+    )
+
+
+class UnblockProvider:
+    def __init__(
+        self,
+        store,
+        bridge,
+        vault,
+        *,
+        issuer_origin,
+        upstream_factory=upstream_api,
+        now=time.time,
+        allowed_resources=(),
+    ):
+        parts = urlsplit(issuer_origin)
+        if (
+            parts.scheme != "https"
+            or not parts.hostname
+            or parts.username
+            or parts.password
+            or parts.path not in ("", "/")
+            or parts.query
+            or parts.fragment
+            or parts.port not in (None, 443)
+        ):
+            raise ValueError("trusted HTTPS issuer origin required")
+        self.store, self.bridge, self.vault = store, bridge, vault
+        self.origin, self.now = issuer_origin.rstrip("/"), now
+        self.upstream_factory = upstream_factory
+        self.allowed_resources = (
+            None
+            if allowed_resources is None
+            else frozenset(_resource(value) for value in allowed_resources)
+        )
+        self.transactions = Transactions(store, now=now)
+
+    async def _read(self, key):
+        try:
+            return await asyncio.to_thread(self.store.read, key)
+        except Exception:
+            raise BridgeUnavailable("authorization state unavailable") from None
+
+    async def _required(self, key):
+        observed = await self._read(key)
+        if observed is None:
+            raise BridgeRejected("authorization transaction not found")
+        return observed
+
+    async def _create(self, key, value):
+        try:
+            await asyncio.to_thread(self.store.create, key, value)
+        except Exception:
+            observed = await self._read(key)
+            if observed is None or observed[0] != value:
+                raise BridgeUnavailable(
+                    "authorization state publication unresolved"
+                ) from None
+
+    async def _begin(self, key, binding, expiry):
+        try:
+            await asyncio.to_thread(self.transactions.begin, key, binding, expiry)
+        except Exception:
+            observed = await self._read(key)
+            if (
+                observed is None
+                or observed[0].get("binding") != binding
+                or observed[0].get("expires_at") != expiry
+                or observed[0].get("status") != "pending"
+            ):
+                raise BridgeUnavailable(
+                    "authorization transaction publication unresolved"
+                ) from None
+
+    async def _checkpoint(self, key, claim, name, value):
