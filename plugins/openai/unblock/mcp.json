{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "unblock": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "mcp==2.3.0",
        "python",
        "${PLUGIN_ROOT}/scripts/run_mcp.py"
      ]
    }
  }
}
